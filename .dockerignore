# Website Docker build - context is repo root
# Only include what's needed for the website build

# Ignore everything by default
*

# Allow workspace config
!package.json
!pnpm-workspace.yaml
!pnpm-lock.yaml
!CHANGELOG.md
!feature-status.json

# Screenshot masters: the landing page's product clips fall back to them until a clip is recorded
!brand/screenshots/

# Allow website app
!apps/website/

# But ignore website build artifacts and node_modules
apps/website/node_modules
apps/website/dist
apps/website/nginx-generated
apps/website/.astro
apps/website/playwright-report
apps/website/test-results
