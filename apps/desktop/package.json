{
  "name": "@cmdr/desktop",
  "version": "0.58.0",
  "description": "",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:no-sync": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "node scripts/tauri-wrapper.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,svelte}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,svelte}\" --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e:linux": "./scripts/e2e-linux.sh",
    "test:e2e:linux:build": "./scripts/e2e-linux.sh --build --build-only",
    "test:e2e:linux:shell": "./scripts/e2e-linux.sh --shell",
    "test:e2e:linux:vnc": "./scripts/e2e-linux.sh --vnc",
    "test:e2e:playwright": "npx playwright test --config test/e2e-playwright/playwright.config.ts --project=tauri",
    "test:e2e:playwright:build": "CMDR_E2E_BUILD=1 CARGO_INCREMENTAL=1 node scripts/tauri-wrapper.ts build --no-bundle --target $(rustc -vV | grep host | cut -d' ' -f2) -- --profile e2e --features playwright-e2e,virtual-mtp",
    "knip": "knip",
    "check:type-drift": "node scripts/check-type-drift.ts",
    "bindings:regen": "cargo nextest run --locked --workspace --features cmdr/virtual-mtp --no-fail-fast --run-ignored=ignored-only ipc::tests::export_bindings_test && pnpm exec oxfmt src/lib/ipc/bindings.ts",
    "intl:keys": "node scripts/gen-message-keys.ts && pnpm exec oxfmt src/lib/intl/keys.gen.ts",
    "intl:shipped-locales": "node scripts/gen-shipped-locales.ts",
    "intl:native-strings": "node scripts/gen-native-strings.ts",
    "i18n:pseudo": "node scripts/gen-pseudolocale.ts",
    "i18n:check-stale": "node scripts/i18n-check-stale.ts",
    "i18n:check-parity": "node scripts/i18n-check-parity.ts",
    "i18n:check-icu": "node scripts/i18n-check-icu.ts",
    "i18n:check-plural": "node scripts/i18n-check-plural.ts",
    "i18n:check-coverage": "node scripts/i18n-check-coverage.ts",
    "i18n:check-dont-translate": "node scripts/i18n-check-dont-translate.ts",
    "i18n:check-quoted-labels": "node scripts/i18n-check-quoted-labels.ts",
    "i18n:check-locale": "node scripts/i18n-check-locale.ts",
    "i18n:check-term-consistency": "node scripts/i18n-check-term-consistency.ts",
    "i18n:check-aria-label": "node scripts/i18n-check-aria-label.ts",
    "i18n:check-termbase": "node scripts/i18n-check-termbase.ts",
    "i18n:check-mechanics": "node scripts/i18n-check-mechanics.ts",
    "i18n:brief": "node scripts/i18n-brief.ts",
    "analytics:defaults": "node scripts/gen-analytics-defaults.ts",
    "marketing:shots": "node scripts/marketing-shots.ts",
    "i18n:couple": "node scripts/couple-screenshots.ts",
    "i18n:shots": "node scripts/i18n-capture.ts && node scripts/couple-screenshots.ts",
    "i18n:shots:no-couple": "node scripts/i18n-capture.ts",
    "i18n:shots:overflow": "node scripts/i18n-capture.ts --locale en-XA"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@ark-ui/svelte": "~5.24.3",
    "@chenglou/pretext": "^1.0.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@logtape/logtape": "^2.4.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "intl-messageformat": "^12.1.4",
    "snarkdown": "2.0.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-library": "10.3.0",
    "@eslint/js": "^10.0.1",
    "@guidepup/virtual-screen-reader": "0.33.0",
    "@iconify-json/lucide": "1.2.149",
    "@playwright/test": "^1.64.1",
    "@srsholmes/tauri-playwright": "^0.4.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "~4.14.0",
    "cldr-core": "49.0.0",
    "dom-accessibility-api": "0.7.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "knip": "^6.44.0",
    "oxlint": "^1.89.0",
    "postcss-html": "^2.0.0",
    "rollup-plugin-sbom": "4.0.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-icons": "24.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
