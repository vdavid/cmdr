 <?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Cmdr</string>

    <!-- Liquid Glass icon for macOS Tahoe (26+). Older macOS falls back to CFBundleIconFile (.icns). -->
    <key>CFBundleIconName</key>
    <string>Sequoia</string>

    <!-- Turns off libmalloc's cache of freed large blocks, which otherwise parks hundreds of MB
         after a search or a restic open with no way to ask for it back. Undocumented, so it has
         a per-macOS-release re-check: `docs/notes/performance/malloc-large-cache-2026-11-03.md`. -->
    <key>LSEnvironment</key>
    <dict>
        <key>MallocLargeCache</key>
        <string>0</string>
    </dict>

    <!-- "Open in Cmdr" in Finder's right-click menu, for files and folders. `NSMessage` plus
         `:userData:error:` is the method on `reveal/service.rs`'s provider. The empty
         `NSRequiredContext` is what lets macOS show it without the person enabling it first. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <!-- generated: pnpm intl:native-strings -->
                <key>default</key>
                <string>Open in Cmdr</string>
                <key>cs</key>
                <string>Otevřít v Cmdru</string>
                <key>de</key>
                <string>In Cmdr öffnen</string>
                <key>es</key>
                <string>Abrir en Cmdr</string>
                <key>fr</key>
                <string>Ouvrir dans Cmdr</string>
                <key>hu</key>
                <string>Megnyitás a Cmdrben</string>
                <key>pt</key>
                <string>Abrir no Cmdr</string>
                <key>ru</key>
                <string>Открыть в Cmdr</string>
                <key>sv</key>
                <string>Öppna i Cmdr</string>
                <key>uk</key>
                <string>Відкрити у Cmdr</string>
                <key>vi</key>
                <string>Mở trong Cmdr</string>
                <key>zh-Hans</key>
                <string>在 Cmdr 中打开</string>
                <key>zh-Hant</key>
                <string>在 Cmdr 中開啟</string>
                <!-- end generated -->
            </dict>
            <key>NSMessage</key>
            <string>openInCmdr</string>
            <key>NSPortName</key>
            <string>Cmdr</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.item</string>
            </array>
        </dict>
    </array>

    <!-- Privacy usage descriptions shown in macOS TCC prompts. Value-first copy with the
         "grant FDA for fewer popups" hint where it applies. Keep each string ≤200 chars. -->
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Cmdr needs this access to let you browse your downloads. If you want fewer popups, grant Cmdr "Full Disk Access" in System Settings → Privacy &amp; Security.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Cmdr needs this access to let you browse your docs. If you want fewer popups, grant Cmdr "Full Disk Access" in System Settings → Privacy &amp; Security.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Cmdr needs this access to let you browse your Desktop. If you want fewer popups, grant Cmdr "Full Disk Access" in System Settings → Privacy &amp; Security.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Cmdr needs Local Network access to let you connect to SMB servers (NAS, file shares) super fast! Cmdr's connection is 4–30x faster than macOS's built-in mount.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>Cmdr needs this access to let you browse your network shares/drives. If you want fewer popups, grant Cmdr "Full Disk Access" in System Settings.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>Cmdr needs this access to let you browse the USB drives, SD cards, and external disks you connect. If you Don't Allow, macOS won't let Cmdr access those devices.</string>
    <!-- Shown in the "Cmdr wants access to control Finder" prompt on the first Get info.
         `osascript` sends the event, but macOS attributes it to Cmdr and reads this key from
         Cmdr's bundle (`src/file_system/get_info.rs`). -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Cmdr asks Finder to open the Get info window for your files. It doesn't ask Finder for anything else.</string>
    <key>NSAppleMusicUsageDescription</key>
    <string>Cmdr reads music file metadata to render file icons matching Apple Music. Cmdr doesn't read your library. If you want fewer popups, grant Cmdr "Full Disk Access" in System Settings.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Cmdr reads image file metadata to render thumbnails for your photos. We don't read your library or upload anything. If you want fewer popups, grant Cmdr "Full Disk Access" in System Settings.</string>
</dict>
</plist>
