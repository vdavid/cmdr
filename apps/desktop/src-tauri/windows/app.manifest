<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The application manifest `build.rs` embeds in the Windows executable, in place of tauri-build's default.
  Why each entry is here: `apps/desktop/src-tauri/DETAILS.md` § "Tauri config per platform".
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- tauri-build's default manifest is exactly this dependency; the native dialogs need Common Controls v6. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Paths past MAX_PATH (260) work once the machine's `LongPathsEnabled` policy is on too. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!-- Per-monitor v2 DPI awareness; `dpiAware` is what an OS without `dpiAwareness` reads instead. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
