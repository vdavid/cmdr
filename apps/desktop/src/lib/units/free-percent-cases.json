    { "name": "a middling drive truncates", "percent": 50.7, "text": "50", "toastText": "50.7" },
    { "name": "just under the 95 band stays whole", "percent": 94.99, "text": "94", "toastText": "94.9" },
    { "name": "the 95 band starts with a tenth", "percent": 95, "text": "95.0", "toastText": "95.0" },
    { "name": "the 95 band truncates its tenth", "percent": 97.86, "text": "97.8", "toastText": "97.8" },
    { "name": "just under the 99 band keeps a tenth", "percent": 98.99, "text": "98.9", "toastText": "98.9" },
    { "name": "the 99 band starts with hundredths", "percent": 99, "text": "99.00", "toastText": "99.00" },
    { "name": "a nearly empty drive", "percent": 99.6, "text": "99.60", "toastText": "99.60" },
    { "name": "the 99 band truncates its hundredths", "percent": 99.648, "text": "99.64", "toastText": "99.64" },
    { "name": "almost empty never reads 100", "percent": 99.999, "text": "99.99", "toastText": "99.99" },
    { "name": "one byte used on a petabyte", "percent": 99.9999999999999, "text": "99.99", "toastText": "99.99" },
