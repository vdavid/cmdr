    "sourceHash": "56ef8f2"
  },
  "servers.sheet.addressPlaceholder": "nas.local",
  "@servers.sheet.addressPlaceholder": {
    "sourceHash": "5e0ec1d",
    "sameAsSourceJustification": "An example hostname (`nas.local`), not prose: `.local` is the mDNS suffix a real Bonjour name carries, so translating it would make the hint wrong. The zh catalog keeps sample values Latin elsewhere too (`fileExplorer.network.login.usernamePlaceholderDefault` = `示例：barry`, `goToPath.dialog.inputPlaceholder` keeps `~/Documents`)."
  },
