  "servers.sheet.protocolSmb": "SMB",
  "@servers.sheet.protocolSmb": {
    "sourceHash": "f54ab2d",
    "sameAsSourceJustification": "Protocol acronym kept verbatim: SMB is on the catalog's BRAND_WORDS list, and macOS zh_CN keeps it Latin too (NetAuthAgent `Localizable.loctable` `SMB_PASSWORD` -> `SMB密码`; verified on macOS 26.6.2 build 25G83, `plutil`, 2026-09-07)."
  },
  "servers.sheet.protocolSftp": "SFTP",
  "@servers.sheet.protocolSftp": {
    "sourceHash": "b07c0f4",
    "sameAsSourceJustification": "Protocol acronym kept verbatim, like every other protocol name in the zh catalog (`WebDAV`, `SMB`, `SSH`, `adb`). macOS zh_CN keeps its sibling acronyms Latin in the same picker family (NetAuthAgent `Localizable.loctable` `AFP_PASSWORD` -> `AFP密码`, `WEBDAV_PASSWORD` -> `WebDAV密码`; verified on macOS 26.6.2 build 25G83, `plutil`, 2026-09-07)."
  },
  "servers.sheet.protocolWebdav": "WebDAV",
  "@servers.sheet.protocolWebdav": {
    "sourceHash": "d92634e",
    "sameAsSourceJustification": "Protocol name kept verbatim: macOS zh_CN writes it Latin (NetAuthAgent `Localizable.loctable` `WEBDAV_PASSWORD` -> `WebDAV密码`; verified on macOS 26.6.2 build 25G83, `plutil`, 2026-09-07), and `servers.refusal.notAWebdavServer` already ships it untranslated in this catalog."
  },
  "servers.sheet.address": "地址",
