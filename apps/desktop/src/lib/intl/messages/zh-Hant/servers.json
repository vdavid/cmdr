  "servers.sheet.protocolSmb": "SMB",
  "@servers.sheet.protocolSmb": {
    "sourceHash": "f54ab2d",
    "sameAsSourceJustification": "“SMB” is a protocol name kept verbatim in Traditional Chinese: it is on Cmdr's BRAND_WORDS list, and Apple's own zh-TW and zh-HK bundles write it Latin (NetAuthAgent `Localizable.loctable` `SMB_PASSWORD` = `SMB密碼`, macOS 26.6.2 build 25G83, verified 2026-09-07). The catalog already ships `SMB 伺服器` on the same reasoning."
  },
  "servers.sheet.protocolSftp": "SFTP",
  "@servers.sheet.protocolSftp": {
    "sourceHash": "b07c0f4",
    "sameAsSourceJustification": "“SFTP” is a protocol name kept verbatim, the same call as its sibling `servers.sheet.protocolSmb`. Apple keeps SSH-family protocol names Latin in Traditional Chinese (`Localizable.loctable` `SSH Protocol 2` = `SSH通訊協定2`, macOS 26.6.2 build 25G83, verified 2026-09-07), and Traditional Chinese has no established rendering of the acronym."
  },
  "servers.sheet.protocolWebdav": "WebDAV",
  "@servers.sheet.protocolWebdav": {
    "sourceHash": "d92634e",
    "sameAsSourceJustification": "“WebDAV” is a protocol name kept verbatim, the same call as its sibling `servers.sheet.protocolSmb`. Apple's zh-TW and zh-HK write it Latin (NetAuthAgent `Localizable.loctable` `WEBDAV_PASSWORD` = `WebDAV密碼`, macOS 26.6.2 build 25G83, verified 2026-09-07), and the catalog already ships it Latin in `servers.refusal.notAWebdavServer`."
  },
  "servers.sheet.address": "位址",
  "@servers.sheet.address": {
    "sourceHash": "56ef8f2"
  },
  "servers.sheet.addressPlaceholder": "nas.local",
  "@servers.sheet.addressPlaceholder": {
    "sourceHash": "5e0ec1d",
    "sameAsSourceJustification": "“nas.local” is a sample hostname shown inside the address field, not prose. A hostname is Latin text the user would type verbatim, so a Traditional Chinese rendering would be a worse hint; Apple keeps example hosts Latin in its zh-TW bundles too (Finder `ConnectToWindow.strings` ships the field with a bare `伺服器位址` label and no localized sample). `.local` is the mDNS suffix and is not translatable."
  },
