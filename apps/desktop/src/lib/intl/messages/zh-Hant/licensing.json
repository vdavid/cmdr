  "licensing.about.linkGithub": "GitHub",
  "@licensing.about.linkGithub": {
    "sourceHash": "f911e41",
    "sameAsSourceJustification": "Brand name `GitHub`, kept verbatim in every locale and on the do-not-translate list. GitHub ships no Traditional Chinese name for itself, and this is the word a reader looks for to recognize the destination. The sibling footer links that are common nouns are translated (`網站`, `取得授權`)."
  },
  "licensing.about.linkDiscord": "Discord",
  "@licensing.about.linkDiscord": {
    "sourceHash": "053bc65",
    "sameAsSourceJustification": "Brand name `Discord`, kept verbatim in every locale. Discord ships no Traditional Chinese name for itself; Apple and Microsoft both keep third-party product names in their Latin form in Traditional Chinese. The sibling footer links that are common nouns are translated (`網站`, `取得授權`)."
  },
  "licensing.about.copyright": "© 2024-2026 David Veszelovszki",
  "@licensing.about.copyright": {
    "sourceHash": "e6ab7e3",
    "sameAsSourceJustification": "A copyright line: the `©` sign, a literal year range, and the author's personal name in Latin script. Traditional Chinese writes copyright notices exactly this way (Apple's own zh-TW About panes keep `© <years> Apple Inc.` unchanged), and none of the three parts is translatable."
  },
