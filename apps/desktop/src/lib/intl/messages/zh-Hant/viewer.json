  "viewer.toolbar.encoding.group.unicode": "Unicode",
  "@viewer.toolbar.encoding.group.unicode": {
    "sourceHash": "f922e0d",
    "sameAsSourceJustification": "Standard name \"Unicode\", kept Latin in Traditional Chinese: it names the character-encoding standard itself and is the term the encodings under it (UTF-8, UTF-16) are branded with. Microsoft zh-Hant keeps `Unicode` verbatim. The sibling group heading `viewer.toolbar.encoding.group.western` is a descriptive word and IS translated."
  },
