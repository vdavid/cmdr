  },
  "queryUi.filters.date.summary.range": "{after} – {before}",
  "@queryUi.filters.date.summary.range": {
    "sourceHash": "801560e",
    "sameAsSourceJustification": "Placeholder-only string: two ISO dates joined by an en dash. ISO 8601 dates stay in their Latin form in every locale (they are Cmdr's house date format), and the en dash is the range mark in Traditional Chinese too. Same shape as `queryUi.filters.size.summary.range`."
  },
