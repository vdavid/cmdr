  "queryUi.filters.size.summary.single": "{prefix} {valueText} {unit}",
  "@queryUi.filters.size.summary.single": {
    "sourceHash": "bbd5deb",
    "sameAsSourceJustification": "Placeholder-only string: `{prefix}` is a math glyph (>, <, =), `{valueText}` a number, `{unit}` a size unit like MB. Nothing outside the placeholders is human-readable text, and Traditional Chinese writes sizes with the same Latin unit symbols and Arabic numerals (style.md § Punctuation). Same shape as `queryUi.filters.size.summary.range`."
  },
  "queryUi.filters.size.summary.range": "{minText} {minUnit} – {maxText} {maxUnit}",
  "@queryUi.filters.size.summary.range": {
    "sourceHash": "ba7eadc",
    "sameAsSourceJustification": "Placeholder-only string: two numbers, two Latin unit symbols, and an en dash for the range. Traditional Chinese uses the en dash for ranges exactly as English does (style.md § Punctuation), so there is nothing to translate. Same shape as `queryUi.filters.size.summary.single`."
  },
  "queryUi.filters.date.summary.after": "{date} 之後",
