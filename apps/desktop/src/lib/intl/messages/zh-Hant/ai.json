  "ai.local.modelSizeUnknown": "?",
  "@ai.local.modelSizeUnknown": {
    "sourceHash": "8a8de82",
    "sameAsSourceJustification": "A single question mark, shown in parentheses where a model's size would go when the backend reported none. The full-width `？` is for sentence-final questions, and Traditional Chinese uses the same half-width `?` glyph as a bare unknown-value placeholder (Apple writes unknown numeric fields as `--` or `?` without localizing the glyph). There is no word to translate; the sibling `ai.local.modelUnknown` handles the case where a WORD is wanted and IS translated (`不明`)."
  },
