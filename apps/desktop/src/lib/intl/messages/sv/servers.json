  "servers.sheet.protocolSmb": "SMB",
  "@servers.sheet.protocolSmb": {
    "sourceHash": "f54ab2d",
    "sameAsSourceJustification": "SMB is a protocol name and stays verbatim in Swedish; style.md lists it under brand and do-not-translate, and the catalog already writes it bare (settings.network.smbConcurrency.*, fileExplorer.smbReconnect.*). Deliberately identical."
  },
  "servers.sheet.protocolSftp": "SFTP",
  "@servers.sheet.protocolSftp": {
    "sourceHash": "b07c0f4",
    "sameAsSourceJustification": "SFTP is a protocol name and stays verbatim in Swedish, the same reflex as the SMB option beside it; macOS sv keeps protocol abbreviations Latin (NetAuthAgent Localizable.loctable sv: 'FTP-lösenord', 'WebDAV-lösenord', 'AFP-lösenord', read on macOS 26.6.2 build 25G83, 2026-09-06). Deliberately identical."
  },
  "servers.sheet.protocolWebdav": "WebDAV",
  "@servers.sheet.protocolWebdav": {
    "sourceHash": "d92634e",
    "sameAsSourceJustification": "WebDAV is a protocol name and stays verbatim in Swedish; macOS sv writes it Latin in NetAuthAgent Localizable.loctable ('WebDAV-lösenord' = WebDAV Password, read on macOS 26.6.2 build 25G83, 2026-09-06), and the catalog's servers.refusal.notAWebdavServer already carries it bare. Deliberately identical."
  },
