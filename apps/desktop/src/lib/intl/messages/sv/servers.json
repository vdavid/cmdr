  "servers.sheet.addressPlaceholder": "nas.local",
  "@servers.sheet.addressPlaceholder": {
    "sourceHash": "5e0ec1d",
    "sameAsSourceJustification": "A sample hostname, not prose: 'nas' plus the .local mDNS suffix macOS itself uses for Bonjour names, which is the same in Swedish. The @key says to leave it as-is or pick an equally short one, and no shorter Swedish-flavoured example exists. Deliberately identical."
  },
