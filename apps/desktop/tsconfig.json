{
  // `$app/tsconfig` (generated by `svelte-kit sync`) carries the bundler-mode basics, including
  // `allowImportingTsExtensions`, which the `scripts/*.ts` need: Node runs them directly via native
  // type stripping, so their relative imports carry the real `.ts` extension.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    // Pinned for the Safari 15.4 floor (a fully patched Catalina), so a newer standard-library
    // function is a type error here instead of a TypeError on that Mac. ❌ Don't widen it to make
    // one compile: feature-check the call and cast locally. Why and how: `src/webkit-floor.d.ts`.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // No enums, namespaces with values, or parameter properties: Node runs `scripts/*.ts` by
    // stripping types, which can't erase those, and with no enum anywhere ESLint can skip
    // `no-unsafe-enum-assignment`, which cost ~17 s per Svelte lint pass guarding one enum
    // (`docs/notes/performance/local-check-lanes-2026-11-05.md`). Use an `as const` object.
    "erasableSyntaxOnly": true,
    // Mirrors package.json `imports` for `svelte-check --tsgo`, whose write-to-disk mode rebases
    // tsconfig `paths` onto its emitted components but ignores subpath `imports`: without this,
    // every `#lib/*.svelte` import falls back to the ambient `*.svelte` shim, which reports 46
    // false errors AND silently drops prop checks on those components (verified on svelte-check
    // 4.7.8 + TS 7.0.2, seeded `<StatusBadge status={12345} />`, 2026-11-10; upstream
    // sveltejs/language-tools#3142). `tsconfig-paths-mirror` keeps the two in step.
    "paths": { "#lib/*": ["./src/lib/*"] }
  },
  // `test/fixtures/*.svelte` are components a unit test mounts (they'd fail
  // `a11y-coverage` under `src/lib`, which they aren't part of), so they belong to
  // this project like the tests that import them. The two E2E suites keep their own
  // tsconfig; everything else under `test/` is data or fixture generators.
  "include": ["src", "scripts", "test/fixtures/*.svelte", "vite.config.js", "vitest.config.ts", "playwright.config.ts"]
}
