{
  // `$app/tsconfig` (generated by `svelte-kit sync`) carries the bundler-mode basics, including
  // `allowImportingTsExtensions`, which the `scripts/*.ts` need: Node runs them directly via native
  // type stripping, so their relative imports carry the real `.ts` extension.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    // Pinned for the Safari 15.4 floor (a fully patched Catalina), so a newer standard-library
    // function is a type error here instead of a TypeError on that Mac. ❌ Don't widen it to make
    // one compile: feature-check the call and cast locally. Why and how: `src/webkit-floor.d.ts`.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  // `test/fixtures/*.svelte` are components a unit test mounts (they'd fail
  // `a11y-coverage` under `src/lib`, which they aren't part of), so they belong to
  // this project like the tests that import them. The two E2E suites keep their own
  // tsconfig; everything else under `test/` is data or fixture generators.
  "include": ["src", "scripts", "test/fixtures/*.svelte", "vite.config.js", "vitest.config.ts", "playwright.config.ts"]
}
