# E2E base image for Cmdr: the slow-changing system layer.
#
# Everything expensive and rarely-edited lives here: apt packages, Node, pnpm,
# and Rust. `e2e-linux.sh` builds this as `cmdr-e2e-base:<sha256[0..12] of this
# file>`, so editing this file auto-invalidates the tag and triggers a rebuild;
# an unchanged file reuses the existing image with zero build work. CI persists
# the built image as a docker-save tar via actions/cache, keyed on the same
# file hash. The fast-changing part (entrypoint.sh) lives in `Dockerfile`,
# which builds FROM this image in ~1 s.

FROM ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7

# Avoid prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install Tauri dependencies (matching official prerequisites)
# See: https://tauri.app/start/prerequisites/#linux
RUN apt-get update && apt-get install -y \
    # Official Tauri prerequisites for Debian
    libwebkit2gtk-4.1-dev \
    build-essential \
    curl \
    wget \
    file \
    libxdo-dev \
    libssl-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    # ACL support for file operations
    libacl1-dev \
    # Needed by tauri-cli when building the app inside the container
    patchelf \
    # X11 virtual framebuffer for headless GUI
    xvfb \
    dbus-x11 \
    # X11 libraries needed for GTK
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxcursor1 \
    libxi6 \
    libxtst6 \
    libxrender1 \
    # GLib/GTK additional runtime
    libglib2.0-0 \
    libpango-1.0-0 \
    libcairo2 \
    libatk1.0-0 \
    libgdk-pixbuf-2.0-0 \
    # Chromium runtime libs for Playwright's headless_shell. The tauri-playwright
    # fixture launches a real headless chromium even though no spec drives a
    # browser directly, so the binary needs these to start. We install them here
    # (plain apt on 26.04) instead of via `playwright install --with-deps`, which
    # fails on 26.04 because Playwright 1.59 only knows ubuntu <=24.04. Keep this
    # list in sync with Playwright's chromium deps when bumping the version (see
    # node_modules/playwright-core/.../registry/nativeDeps.js, ubuntu24.04-x64).
    libnss3 \
    libnspr4 \
    libgbm1 \
    libdrm2 \
    libcups2t64 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libatk-bridge2.0-0 \
    libasound2t64 \
    libxcb1 \
    # Go (needed by beforeBuildCommand for llama-server placeholder). Deliberately
    # whatever apt ships rather than the `.mise.toml` toolchain: the placeholder
    # generator is not version-sensitive, and matching mise here would mean a
    # tarball download plus a build arg for no gain. This is the one Go in the repo
    # that doesn't track the single source, and it names no version, so
    # `go-version-single-source` stays green over it.
    golang-go \
    # VNC for interactive debugging (--vnc mode)
    x11vnc \
    novnc \
    python3-websockify \
    # SMB support for network E2E tests
    smbclient \
    # The server specs' side door to the SFTP fixture (e2e-shared/server-fixtures.ts):
    # named here rather than trusted to arrive as some other package's recommend
    openssh-client \
    cifs-utils \
    # Git for tests that synthesize repository fixtures (git-portal.spec.ts)
    git \
    # GVFS for gio mount (used by Cmdr's mount_linux.rs for user-space SMB mounting)
    gvfs \
    gvfs-backends \
    gvfs-daemons \
    gvfs-fuse \
    gvfs-common \
    gvfs-libs \
    # Useful utilities
    ca-certificates \
    # Clean up
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 LTS and Rust come from the official images, pinned by digest, so the toolchain is
# exactly what Renovate last reviewed rather than whatever a `curl | sh` installer served today.
# Node's binaries are built against an old glibc and run unchanged on Ubuntu.
COPY --from=node:22-trixie-slim@sha256:154ba2f4d6fec323d28e4f4bb86bba4677f1223391a1979cf521304e03a98dfa /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-trixie-slim@sha256:154ba2f4d6fec323d28e4f4bb86bba4677f1223391a1979cf521304e03a98dfa /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

# pnpm through corepack, which fetches the version the repo's `packageManager` names at first use
# and checks the npm registry's signature on it.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable pnpm

# Rust (needed to compile the Tauri binary with --features playwright-e2e). The bind-mounted
# registry cache in `e2e-linux.sh` lives under /root/.cargo, so the toolchain moves there too.
# `rust-toolchain.toml` still picks the compiler; matching the image to its pin saves the download.
COPY --from=rust:1.97.1-slim-trixie@sha256:8e8cf8f7fd54a2d23d5a743b3a03f56e26b6c774276c33fa0595111704ebb15c /usr/local/cargo /root/.cargo
COPY --from=rust:1.97.1-slim-trixie@sha256:8e8cf8f7fd54a2d23d5a743b3a03f56e26b6c774276c33fa0595111704ebb15c /usr/local/rustup /root/.rustup
ENV CARGO_HOME=/root/.cargo RUSTUP_HOME=/root/.rustup
ENV PATH="/root/.cargo/bin:${PATH}"

# Set up display for Xvfb
ENV DISPLAY=:99

# Playwright doesn't publish chromium binaries for ubuntu26.04 yet, but the
# ubuntu24.04 build runs fine on 26.04 (libc-compatible). Without an override,
# `npx playwright install chromium` errors with "Playwright does not support
# chromium on ubuntu26.04[-arm64]". The override has to be arch-aware (arm64
# locally on macOS, x64 in CI on GitHub-hosted Linux runners) — set it in
# entrypoint.sh based on `dpkg --print-architecture`, not as a static ENV here.
# Drop this once Playwright adds 26.04 to its supported list.
