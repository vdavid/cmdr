---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CheckIcon from '../components/CheckIcon.astro'
import Icon from '../components/icons/Icon.astro'
import NewsletterInlineWrapper from '../components/NewsletterInlineWrapper.astro'
import { roadmapSections } from '../lib/roadmap'

// Roadmap items live in `src/lib/roadmap.ts`; this page only lays them out. Titles and descriptions
// are inline HTML (a few carry `<em>`, a link, or a `title=` span), so they render through `set:html`.
---

<Layout title="Roadmap - Cmdr" description="What's shipped and what's coming next in Cmdr.">
    <Header />
    <main class="mx-auto max-w-4xl px-6 pt-32 pb-24">
        <header class="mb-10">
            <h1 class="mb-4 text-3xl font-bold tracking-tight text-text-primary md:text-4xl">Roadmap</h1>
            <p class="text-text-secondary">
                What's shipped, what's next. Wondering how solid each feature is? See the <a
                    href="/features"
                    class="text-accent-text underline underline-offset-2 hover:text-accent-hover"
                    >feature status</a
                > page.
            </p>
            <p>&nbsp;</p>
            <p class="text-text-secondary">
                I'm also pretty proud of Cmdr's history, so keeping the list of the major milestones here.
            </p>
        </header>

        <div class="roadmap-content">
            {
                roadmapSections.map((section) => (
                    <section class="year-section">
                        {section.spacerAbove && <p>&nbsp;</p>}
                        <h2 id={section.id}>{section.heading}</h2>
                        {section.groups.map((group) => (
                            <Fragment>
                                {group.heading && <h3>{group.heading}</h3>}
                                <ul class="milestone-list">
                                    {group.milestones.map((milestone) => (
                                        <li>
                                            <span class="lead">
                                                <CheckIcon checked={milestone.done} />
                                                <span class="date">{milestone.date}</span>
                                            </span>
                                            <span class="body">
                                                <span class="title">
                                                    <Fragment set:html={milestone.title} />
                                                    {milestone.icon && (
                                                        <Icon name={milestone.icon} size={18} class="ml-1.5" />
                                                    )}
                                                </span>
                                                <span class="description" set:html={milestone.description} />
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                            </Fragment>
                        ))}
                    </section>
                ))
            }
        </div>

        <div class="mt-16">
            <NewsletterInlineWrapper label="Wanna stay looped in?" />
        </div>
    </main>
    <Footer />
</Layout>

<style>
    /* Two columns: [checkbox + date] and [title + description]. A grid on .roadmap-content
       defines the tracks, and each section, list, and row is a column subgrid, so the lead
       column sizes to the widest checkbox + date anywhere on the page and every title starts
       at the same x across all months. */
    .roadmap-content {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        font-family: var(--font-sans) sans-serif;
        line-height: 1.5;
    }

    .year-section {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1 / -1;
        margin-bottom: 2.5rem;
    }

    .year-section > h2,
    .year-section > h3,
    .year-section > p {
        grid-column: 1 / -1;
    }

    .year-section h2 {
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-border);
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--color-accent-text);
    }

    .year-section h3 {
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        font-size: 1rem;
        font-weight: 500;
        color: var(--color-text-secondary);
    }

    .milestone-list {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1 / -1;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .milestone-list li {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1 / -1;
        align-items: center;
        column-gap: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--color-border-subtle);
    }

    .milestone-list li:last-child {
        border-bottom: none;
    }

    .lead {
        grid-column: 1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .body {
        grid-column: 2;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.25rem 0.5rem;
    }

    .title {
        font-weight: 600;
        color: var(--color-text-primary);
    }

    .description {
        color: var(--color-text-secondary);
    }

    .date {
        flex-shrink: 0;
        color: var(--color-text-tertiary);
        font-size: 0.875rem;
        font-family: var(--font-mono) monospace;
    }
</style>
