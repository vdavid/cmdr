---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import DownloadButton from '../components/DownloadButton.astro'
import PageHeader from '../components/PageHeader.astro'

// Paddle config - passed to client-side script
const paddleToken = import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN ?? ''
const paddleEnvironment = (import.meta.env.PUBLIC_PADDLE_ENVIRONMENT ?? 'sandbox') as 'sandbox' | 'live'
const allowSandboxInProd = import.meta.env.PUBLIC_PADDLE_ALLOW_SANDBOX === 'true'

// Guardrails: a production build must never silently ship the sandbox (test-mode) checkout.
// Astro bakes these PUBLIC_ vars into the static JS at build time, so a sandbox token in the
// deploy environment ships a live site that only accepts Paddle's test cards: real customers
// can't pay, with no error anywhere. The deploy script builds before swapping containers, so a
// throw here fails the deploy safely (the old site stays up) instead of going live broken.
// Escape hatch: PUBLIC_PADDLE_ALLOW_SANDBOX=true to intentionally build sandbox checkout (local
// `pnpm check` website build / e2e against the sandbox creds in a dev `.env`).
if (paddleToken) {
    if (import.meta.env.PROD && paddleEnvironment !== 'live' && !allowSandboxInProd) {
        throw new Error(
            'Paddle is in sandbox mode for a production build. Set PUBLIC_PADDLE_ENVIRONMENT=live with a ' +
                'live_ client token, or set PUBLIC_PADDLE_ALLOW_SANDBOX=true to build sandbox checkout on purpose.',
        )
    }
    if (paddleEnvironment === 'live' && !paddleToken.startsWith('live_')) {
        throw new Error('PUBLIC_PADDLE_ENVIRONMENT=live but PUBLIC_PADDLE_CLIENT_TOKEN is not a live_ token.')
    }
    if (paddleEnvironment === 'sandbox' && !paddleToken.startsWith('test_')) {
        throw new Error('PUBLIC_PADDLE_ENVIRONMENT=sandbox but PUBLIC_PADDLE_CLIENT_TOKEN is not a test_ token.')
    }
}

const paddleConfig = {
    clientToken: paddleToken,
    environment: paddleEnvironment,
    priceIds: {
        commercialSubscription: import.meta.env.PUBLIC_PADDLE_PRICE_ID_COMMERCIAL_SUBSCRIPTION ?? '',
        commercialPerpetual: import.meta.env.PUBLIC_PADDLE_PRICE_ID_COMMERCIAL_PERPETUAL ?? '',
    },
}
const isPaddleConfigured = paddleConfig.clientToken !== ''

// FAQ data: single source of truth for both visible cards and ld+json structured data.
// `answer` is plain text (used in ld+json). `answerHtml` is optional rich HTML for the visible card.
const faq = [
    {
        question: 'What counts as "commercial use"?',
        answer: "Well, you know. If you're making money (getting a salary, having contracts, etc.) in relation to what you use those files for, that's commercial use. Can be employment, freelancing, consulting. These cases need a Commercial license at $59/year. Organizing your family photos, copying files for your hobby projects, doing your open source work or volunteering, these are Personal use and Cmdr is 100% free for these things.",
    },
    {
        question: 'Can I use it on multiple machines?',
        answer: "Yes! Use Cmdr on as many machines as you like with a single Commercial license, as long as you're the only person using it. You can install it on your laptop, desktop, remote debugging VM thing, whatever you like. The license is per person, not per machine.",
    },
    {
        question: "What's the Commercial vs. Perpetual license?",
        answer: "The perpetual license is a bigger initial commitment, but it's better for budgeting at some companies. Then they are the same for the first year: you get all updates, etc. After that, the perpetual license allows you to keep it forever.",
    },
    {
        question: 'Can I see the source code?',
        answer: "Yes! Cmdr is source-available. You can view the code, learn from it, verify that there are no nasty backdoors or any other weird stuff going on. You just can't reuse or republish the code or the app. The BSL 1.1 license converts to AGPL-3.0 after 3 years, meaning that if the dev gets hit by a bus, you won't end up without updates forever.",
        answerHtml: 'Yes! Cmdr is <a href="https://github.com/vdavid/cmdr" target="_blank" rel="noopener noreferrer" class="text-accent-text underline underline-offset-2 hover:text-accent-hover">source-available</a>. You can view the code, learn from it, verify that there are no nasty backdoors or any other weird stuff going on. Just you can\'t reuse/republish the code or the app. The BSL 1.1 license converts to AGPL-3.0 after 3 years, meaning that if the dev gets hit by a bus, you won\'t end up without updates forever.',
    },
    {
        question: 'What if I regret the purchase?',
        answer: "30-day, no-questions-asked refund. Send an email and you'll get your money back.",
        answerHtml: '<a href="/refund" class="text-accent-text underline underline-offset-2 hover:text-accent-hover">30-day, no-questions-asked refund</a>. Send an email and you\'ll get your money back.',
    },
    {
        question: 'Do you offer team licenses?',
        answer: 'Each person needs their own license. For teams of 10+ people, email legal@getcmdr.com for volume pricing.',
        answerHtml: 'Each person needs their own license. For teams of 10+ people, email <a href="mailto:legal@getcmdr.com" class="text-accent-text underline underline-offset-2 hover:text-accent-hover">legal@getcmdr.com</a> for volume pricing.',
    },
]
---

<Layout title="Pricing - Cmdr" description="Cmdr is free for personal use. Commercial licenses from $59/year.">
    <Header />
    <main class="mx-auto max-w-5xl px-6 pt-32 pb-24">
        <!-- Hero -->
        <PageHeader title="Free for personal use" class="mb-10">
            Use Cmdr at home without paying a cent. Less than a coffee a month for work.
        </PageHeader>

        <!-- Download Button -->
        <div class="mb-16">
            <DownloadButton variant="pricing" />
            <p class="mt-3 text-sm text-text-tertiary">macOS only · Source-available (BSL 1.1)</p>
        </div>

        <!-- Pricing Cards -->
        <div class="mb-16 grid gap-6 md:grid-cols-3">
            <!-- Personal (Free) -->
            <div class="flex flex-col rounded-2xl border border-border bg-surface p-6">
                <div class="mb-4">
                    <h2 class="text-lg font-semibold text-text-primary">Personal</h2>
                    <p class="text-sm text-text-tertiary">For hobbyists and side projects</p>
                </div>
                <div class="mb-6">
                    <span class="text-3xl font-bold text-text-primary">Free</span>
                    <span class="text-text-tertiary"> forever</span>
                </div>
                <ul class="mb-6 space-y-2 text-sm text-text-secondary">
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        All features
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        Unlimited machines
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        Automatic updates
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-text-tertiary">✗</span>
                        <span class="text-text-tertiary">Commercial use</span>
                    </li>
                </ul>
                <div class="mt-auto py-2 text-center text-sm text-text-tertiary">Just download and use it</div>
            </div>

            <!-- Commercial Subscription -->
            <div
                class="relative mt-4 flex flex-col rounded-2xl border-2 border-accent bg-surface p-6 shadow-lg md:mt-0"
            >
                <div
                    class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-accent px-3 py-1 text-xs font-medium text-accent-contrast"
                >
                    Most popular
                </div>
                <div class="mb-4">
                    <h2 class="text-lg font-semibold text-text-primary">Commercial</h2>
                    <p class="text-sm text-text-tertiary">For work use</p>
                </div>
                <div class="mb-6">
                    <span class="text-lg text-text-tertiary line-through">$79</span>
                    <span class="text-3xl font-bold text-text-primary"> $59</span>
                    <span class="text-text-tertiary">/year</span>
                    <div class="mt-1 text-xs text-accent-text">First 1,000 licenses</div>
                </div>
                <ul class="mb-6 space-y-2 text-sm text-text-secondary">
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        All features
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        <strong class="text-text-primary">Commercial use</strong>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        Per user, your own devices
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        Auto-renews annually
                    </li>
                </ul>
                <button
                    type="button"
                    data-paddle-price="commercialSubscription"
                    disabled={!isPaddleConfigured}
                    class="mt-auto block w-full cursor-pointer rounded-lg bg-accent py-2 text-center text-sm font-medium text-accent-contrast transition-all duration-200 hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-primary disabled:cursor-not-allowed disabled:opacity-50"
                >
                    Buy commercial license
                </button>
            </div>

            <!-- Commercial Perpetual -->
            <div class="flex flex-col rounded-2xl border border-border bg-surface p-6">
                <div class="mb-4">
                    <h2 class="text-lg font-semibold text-text-primary">Perpetual</h2>
                    <p class="text-sm text-text-tertiary">Buy once, use forever</p>
                </div>
                <div class="mb-6">
                    <span class="text-3xl font-bold text-text-primary">$199</span>
                    <span class="text-text-tertiary"> one-time</span>
                </div>
                <ul class="mb-6 space-y-2 text-sm text-text-secondary">
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        All features
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        <strong class="text-text-primary">Commercial use</strong>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        Per user, your own devices
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-accent-text">✓</span>
                        1 year of updates
                    </li>
                </ul>
                <button
                    type="button"
                    data-paddle-price="commercialPerpetual"
                    disabled={!isPaddleConfigured}
                    class="mt-auto block w-full cursor-pointer rounded-lg border border-border py-2 text-center text-sm font-medium text-text-primary transition-colors hover:bg-surface-elevated focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-50"
                >
                    Buy perpetual license
                </button>
            </div>
        </div>

        <!-- FAQ Section: ld+json and visible cards both render from the `faq` array in frontmatter -->
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": faq.map(({ question, answer }) => ({
                "@type": "Question",
                "name": question,
                "acceptedAnswer": { "@type": "Answer", "text": answer },
            })),
        })} />
        <section>
            <h2 class="mb-8 text-2xl font-bold text-text-primary">
                Frequently asked questions
            </h2>

            <div class="grid gap-6 md:grid-cols-2">
                {faq.map(({ question, answer, answerHtml }) => (
                    <div class="rounded-lg border border-border-subtle bg-surface p-5">
                        <h3 class="mb-2 font-semibold text-text-primary">{question}</h3>
                        <p class="text-text-secondary" set:html={answerHtml ?? answer} />
                    </div>
                ))}
            </div>
        </section>
    </main>
    <Footer />

    {/* Organization name modal for commercial checkouts */}
    <div id="org-name-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="org-modal-title">
        <div class="relative mx-4 w-full max-w-md rounded-2xl border border-border bg-surface p-6 shadow-2xl">
            <button
                type="button"
                id="org-modal-close"
                class="absolute top-4 right-4 rounded-sm text-text-tertiary transition-colors hover:text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                aria-label="Close"
            >
                <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <div class="mb-1 text-xs font-medium tracking-wide text-accent-text uppercase">
                Step 1 of 2
            </div>
            <h2 id="org-modal-title" class="mb-2 text-xl font-semibold text-text-primary">
                Company details
            </h2>
            <p class="mb-6 text-sm text-text-secondary">
                Enter your company name as you'd like it to appear on your invoice.
            </p>

            <div class="mb-4">
                <label for="org-name-input" class="mb-2 block text-sm font-medium text-text-primary">
                    Company name
                </label>
                <input
                    type="text"
                    id="org-name-input"
                    placeholder="Example: Acme Inc."
                    class="w-full rounded-lg border border-border bg-background px-4 py-3 text-text-primary placeholder-text-tertiary transition-colors focus:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                />
            </div>

            <div class="mb-6">
                <label for="org-email-input" class="mb-2 block text-sm font-medium text-text-primary">
                    Email
                </label>
                <input
                    type="email"
                    id="org-email-input"
                    placeholder="Example: you@acme.com"
                    class="w-full rounded-lg border border-border bg-background px-4 py-3 text-text-primary placeholder-text-tertiary transition-colors focus:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                />
            </div>

            <button
                type="button"
                id="org-modal-continue"
                class="w-full cursor-pointer rounded-lg bg-accent py-3 text-center font-medium text-accent-contrast transition-all duration-200 hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-primary disabled:cursor-not-allowed disabled:opacity-50"
            >
                Continue to payment
            </button>

            <p class="mt-4 text-center text-xs text-warning">
                <strong>Need your company address on the invoice?<br /> Click "Add VAT number" before entering your card details.</strong>
            </p>
        </div>
    </div>

    {/* Paddle checkout integration - config passed via data attribute */}
    {
        isPaddleConfigured && (
            <div id="paddle-config" data-config={JSON.stringify(paddleConfig)} class="hidden" />
        )
    }
    {isPaddleConfigured && <script src="https://cdn.paddle.com/paddle/v2/paddle.js" is:inline async />}
    {
        isPaddleConfigured && (
            <script is:inline>
                ;(function () {
                    const configEl = document.getElementById('paddle-config')
                    if (!configEl) return
                    const paddleConfig = JSON.parse(configEl.dataset.config)

                    function initPaddle() {
                        if (paddleConfig.environment === 'sandbox') {
                            window.Paddle.Environment.set('sandbox')
                        }
                        window.Paddle.Initialize({ token: paddleConfig.clientToken })
                    }

                    // Wait for Paddle.js to load (it may arrive after this inline script)
                    if (window.Paddle) {
                        initPaddle()
                    } else {
                        document.querySelector('script[src*="paddle.js"]').addEventListener('load', initPaddle)
                    }

                    // Modal elements
                    const modal = document.getElementById('org-name-modal')
                    const modalNameInput = document.getElementById('org-name-input')
                    const modalEmailInput = document.getElementById('org-email-input')
                    const modalClose = document.getElementById('org-modal-close')
                    const modalContinue = document.getElementById('org-modal-continue')

                    // Track which price is being purchased
                    let pendingPriceId = null
                    let triggerButton = null

                    // Focus trap for modal
                    var focusableSelector = 'button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'

                    function trapFocus(e) {
                        if (e.key !== 'Tab' || modal.classList.contains('hidden')) return
                        var focusable = modal.querySelectorAll(focusableSelector)
                        var first = focusable[0]
                        var last = focusable[focusable.length - 1]
                        if (e.shiftKey) {
                            if (document.activeElement === first) {
                                e.preventDefault()
                                last.focus()
                            }
                        } else {
                            if (document.activeElement === last) {
                                e.preventDefault()
                                first.focus()
                            }
                        }
                    }

                    function showModal() {
                        modal.classList.remove('hidden')
                        modal.classList.add('flex')
                        modalNameInput.value = ''
                        modalEmailInput.value = ''
                        modalNameInput.focus()
                        updateContinueButton()
                        document.addEventListener('keydown', trapFocus)
                    }

                    function updateContinueButton() {
                        const hasName = modalNameInput.value.trim().length > 0
                        const hasEmail = modalEmailInput.value.trim().length > 0
                        modalContinue.disabled = !hasName || !hasEmail
                    }

                    function hideModal() {
                        modal.classList.add('hidden')
                        modal.classList.remove('flex')
                        document.removeEventListener('keydown', trapFocus)
                        if (triggerButton) triggerButton.focus()
                        pendingPriceId = null
                        triggerButton = null
                    }

                    function openPaddleCheckout(priceId, businessName, email) {
                        const checkoutOptions = {
                            items: [{ priceId: priceId }],
                        }

                        // Add customer info for commercial purchases
                        if (email) {
                            checkoutOptions.customer = {
                                email: email,
                            }
                        }

                        // Pass org name via customData - will be included in webhook
                        if (businessName) {
                            checkoutOptions.customData = {
                                organizationName: businessName,
                            }
                        }

                        window.Paddle.Checkout.open(checkoutOptions)
                    }

                    // Handle buy button clicks: all plans go through the org name modal
                    document.querySelectorAll('[data-paddle-price]').forEach(function (button) {
                        button.addEventListener('click', function () {
                            const priceKey = button.dataset.paddlePrice
                            const priceId = paddleConfig.priceIds[priceKey]
                            if (!priceId) return

                            pendingPriceId = priceId
                            triggerButton = button
                            showModal()
                        })
                    })

                    // Modal close button
                    modalClose.addEventListener('click', hideModal)

                    // Click outside modal to close
                    modal.addEventListener('click', function (e) {
                        if (e.target === modal) {
                            hideModal()
                        }
                    })

                    // Escape key to close modal
                    document.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                            hideModal()
                        }
                    })

                    // Continue button - open Paddle with business name and email
                    modalContinue.addEventListener('click', function () {
                        const orgName = modalNameInput.value.trim()
                        const email = modalEmailInput.value.trim()
                        if (!orgName || !email || !pendingPriceId) return

                        const priceIdToUse = pendingPriceId
                        hideModal()
                        openPaddleCheckout(priceIdToUse, orgName, email)
                    })

                    // Enter key in inputs to continue
                    modalNameInput.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter') {
                            modalEmailInput.focus()
                        }
                    })
                    modalEmailInput.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter' && !modalContinue.disabled) {
                            modalContinue.click()
                        }
                    })

                    // Update continue button state when inputs change
                    modalNameInput.addEventListener('input', updateContinueButton)
                    modalEmailInput.addEventListener('input', updateContinueButton)
                    modalContinue.disabled = true
                })()
            </script>
        )
    }
</Layout>
