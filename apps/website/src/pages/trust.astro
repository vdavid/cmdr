} from '../lib/trust'
import { codeCounts, releaseCadence, updateAdoption, window as devWindow } from '../lib/trust-development'

const fmt = (n: number) => n.toLocaleString('en-US')
const euLabel = { yes: 'In the EU', no: 'Outside the EU', partly: 'Partly outside the EU' } as const

const toc = [
    { id: 'summary', label: 'Summary' },
    { id: 'network', label: 'What the app sends over the network' },
    { id: 'mdm', label: 'Central management (MDM)' },
    { id: 'eu', label: 'Does data leave the EU?' },
    { id: 'subprocessors', label: 'Subprocessors' },
    { id: 'storage', label: 'What is stored where, and for how long' },
    { id: 'signing', label: 'Signing, notarization, and updates' },
    { id: 'permissions', label: 'Sandbox and permissions' },
    { id: 'ai', label: 'AI features and your files' },
    { id: 'development', label: 'How Cmdr is built' },
    { id: 'company', label: 'Company, license, and continuity' },
    { id: 'report', label: 'Report a vulnerability' },
    { id: 'gaps', label: 'Not in place yet' },
]
---

<LegalLayout
    title="Trust and security"
    description="What Cmdr sends over the network, where data is stored, how the app is signed and updated, and what isn't in place yet. For security and IT teams."
    lastUpdated={verifiedAgainst.date}
>
    <p>
        This page is for security and IT teams deciding whether to allow Cmdr, a file manager for macOS. It describes
        Cmdr version {verifiedAgainst.version} as of {verifiedAgainst.date}. The source code is public on
        <a href="https://github.com/vdavid/cmdr">GitHub</a>, so you can check every statement here. If something is
        missing or unclear, write to <a href="mailto:security@getcmdr.com">security@getcmdr.com</a>.
    </p>

    <nav aria-label="On this page">
        <ul>
            {
                toc.map((item) => (
                    <li>
                        <a href={`#${item.id}`}>{item.label}</a>
                    </li>
                ))
            }
        </ul>
    </nav>

    <h2 id="summary">Summary</h2>
    <ul>
        <li>
            <strong>Your files stay on your Mac.</strong> File contents never reach Cmdr's servers. Cmdr has no user
            accounts and no cloud storage.
        </li>
        <li>
            <strong>On by default</strong>: update checks, usage stats, and crash reports. Each user can turn each one
            off in Settings, and IT can turn them off for everyone through MDM.
        </li>
        <li>
            <strong>AI is off by default.</strong> If a user turns it on with their own API key, the app talks straight
            to that provider. Nothing goes through Cmdr's servers.
        </li>
        <li>
            <strong>Signed and notarized</strong> with Apple's Developer ID and the hardened runtime. Updates are
            signed separately and checked before they're installed.
        </li>
        <li>
            <strong>Not App Sandboxed.</strong> A file manager needs to reach all your files, so Cmdr asks for Full Disk
            Access. Users can say no.
        </li>
        <li>
            <strong>Some data leaves the EU.</strong> The details are below.
        </li>
        <li>
            <strong>Made by one person</strong> at Rymdskottkärra AB, a Swedish company. The code is public under the
            Business Source License, and each version becomes open source (AGPL-3.0) three years after its release.
        </li>
    </ul>

    <h2 id="network">What the app sends over the network</h2>
    <p>
        This is every connection a release build of the app makes. All of it comes from the app's native code. The
        app's user interface makes no network requests, and its content security policy would block any except to
        <code>getcmdr.com</code>. There are no ads, no third-party trackers, and no remote fonts or scripts in the
        app.
    </p>
    {
        networkConnections.map((connection) => (
            <section aria-labelledby={`net-${connection.id}`}>
                <h3 id={`net-${connection.id}`}>{connection.name}</h3>
                <ul>
                    <li>
                        <strong>Goes to</strong>: <Fragment set:html={connection.destination} />
                    </li>
                    <li>
                        <strong>When</strong>: <Fragment set:html={connection.when} />
                    </li>
                    <li>
                        <strong>Sends</strong>: <Fragment set:html={connection.sends} />
                    </li>
                    <li>
                        <strong>Default and how to turn it off</strong>: <Fragment set:html={connection.control} />
                    </li>
                </ul>
                {connection.devTodo && <DevTodo html={connection.devTodo} />}
            </section>
        ))
    }

    <h3 id="allowlist">Hosts to allow on a proxy or firewall</h3>
    <ul>
        {
            allowlistHosts.map((entry) => (
                <li>
                    <code>{entry.host}</code>: {entry.purpose}
                </li>
            ))
        }
    </ul>
    <p>
        Cmdr follows macOS's proxy settings: an HTTP, HTTPS, or SOCKS proxy set by hand, the list of hosts that bypass
        it, and automatic configuration with a PAC file, which macOS itself runs. If the PAC file can't be loaded, Cmdr
        connects directly, as macOS does. The <code>HTTPS_PROXY</code>, <code>HTTP_PROXY</code>,
        <code>ALL_PROXY</code>, and <code>NO_PROXY</code> environment variables work too and take precedence, including
        a SOCKS address like <code>socks5h://proxy.example:1080</code>. Addresses on the Mac itself always go direct, so
        on-device AI keeps working behind a proxy.
    </p>
    <p>
        Through a SOCKS proxy from macOS's settings, the proxy looks up host names, as macOS itself does, so the names
        Cmdr connects to don't reach the local network's DNS.
    </p>
    <p>
        Cmdr checks server certificates with macOS's own certificate trust, so a company's TLS-inspection certificate
        that the Mac trusts works in Cmdr too. Without that trust, Cmdr refuses the connection.
    </p>
    <p>
        Tested on macOS 27 behind a TLS-inspecting proxy, with its certificate trusted and not trusted, and with a proxy
        set by hand, a bypass list, a PAC file, and a PAC file that can't be reached. SOCKS was tested set by hand,
        through a PAC file, and through <code>ALL_PROXY</code>, also with a user name and password.
    </p>
    <p>
        <strong>What doesn't work yet</strong>: proxies that need a sign-in, unless the user name and password are in
        the proxy's address (<code>HTTPS_PROXY</code> or <code>ALL_PROXY</code>). A PAC file must name a SOCKS proxy as
        <code>SOCKS</code>: macOS's own PAC reader skips <code>SOCKS5</code> and <code>SOCKS4</code>.
    </p>
    <DevTodo>
        Release timing: PAC files, the bypass list, SOCKS proxies, and "the Mac itself always goes direct" ship in the
        release after 0.50.0 (<code>cmdr-http</code>). Until then this section is ahead of the app: 0.50.0 follows only a proxy set by
        hand and the environment variables, and it sends local addresses through the proxy. Automatic proxy discovery
        (WPAD) also works through the PAC path, but wasn't tested end to end, so it isn't claimed above. Evidence:
        <code>docs/notes/proxy-and-tls-inspection-2026-10.md</code>.
    </DevTodo>

    <h3 id="website">The website</h3>
    <p>
        getcmdr.com counts visits with Umami, which runs on Cmdr's own server in Finland and uses no cookies. It also
        uses PostHog (EU cloud) for visit recordings and heatmaps, kept in memory only, so it sets no cookie either.
    </p>

    <h2 id="mdm">Central management (MDM)</h2>
    <p>
        IT can turn off usage stats, reports, updates, and AI for every user with a configuration profile from any
        MDM (Jamf, Kandji, Intune, and others). Cmdr reads managed preferences from the
        <code>com.veszelovszki.cmdr</code> preference domain, the app's bundle id. A user can't change a managed
        setting: Settings shows it locked, with a note that the organization manages it, and the MCP server can't
        change it either. Cmdr picks up a new or changed profile while it runs, before it sends anything else.
    </p>
    <ul>
        <li>
            <a href="/mdm/cmdr-managed-preferences.mobileconfig" download>Sample configuration profile</a>
            (<code>.mobileconfig</code>): every key below with an example value and a comment. It's unsigned, because
            your MDM signs profiles when it deploys them.
        </li>
        <li>
            <a href="/mdm/com.veszelovszki.cmdr.plist" download>Preference file</a> (<code>.plist</code>): the same
            keys on their own, for Jamf Pro's "Application &amp; Custom Settings", a Kandji custom profile, or an
            Intune preference file.
        </li>
        <li>
            <a href="/mdm/cmdr-full-disk-access.mobileconfig" download>Full Disk Access profile</a>
            (<code>.mobileconfig</code>): grants Cmdr Full Disk Access, so users don't have to grant it themselves
            (<a href="#mdm-deploy">deploying Cmdr</a>).
        </li>
    </ul>

    <h3 id="mdm-keys">Keys</h3>
    <p>
        Every key only turns something off or narrows it, and no key can turn anything on. A key that's missing, or
        set to false, leaves that part up to each user.
    </p>
    <ul>
        {
            managedPreferenceKeys.map((entry) => (
                <li>
                    <code>{entry.key}</code> ({entry.type}): <Fragment set:html={entry.effect} />
                </li>
            ))
        }
    </ul>
    <ul>
        <li>
            <strong>Which key wins</strong>: <code>DisableAI</code> beats <code>DisableCloudAI</code>, which beats
            <code>AllowedCloudAIHosts</code>. <code>DisableUpdates</code> beats both other update keys, while
            <code>MaxUpdateVersion</code> and <code>DisableAutomaticUpdateChecks</code> work together.
        </li>
        <li>
            <strong>Values</strong>: a Boolean also accepts the strings <code>true</code>, <code>false</code>,
            <code>yes</code>, <code>no</code>, <code>1</code>, and <code>0</code>, and a number (0 is false). A value
            Cmdr can't read counts as the strictest setting of that key, and Cmdr logs a warning.
        </li>
        <li>
            <strong>Only managed values count.</strong> Cmdr reads only what a profile sets (in
            <code>/Library/Managed Preferences</code>). A user's own <code>defaults write</code> to the same domain
            changes nothing.
        </li>
        <li>
            <strong>Local Ollama or LM Studio only</strong>: <code>DisableCloudAI</code> blocks <code>localhost</code>
            too, so leave it off and set <code>AllowedCloudAIHosts</code> to <code>localhost</code> and
            <code>127.0.0.1</code>.
        </li>
        <li>
            <strong>macOS only.</strong> Cmdr doesn't read managed preferences on other systems.
        </li>
        <li>
            <strong>To check a Mac</strong>, run
            <code>defaults read "/Library/Managed Preferences/com.veszelovszki.cmdr"</code>, which shows what the
            profile delivered.
        </li>
    </ul>

    <h3 id="mdm-heartbeat">What usage stats say about a managed Mac</h3>
    <p>
        If usage stats stay on, the settings values they send are the ones in effect, so a managed setting reports its
        managed value. They add one yes-or-no flag saying that an organization manages some of Cmdr's settings. They
        never say which keys are set or to what.
    </p>

    <h3 id="mdm-not-covered">What no key turns off</h3>
    <ul>
        <li>
            <strong>License checks</strong>: a paid license has to stay checkable. The check sends the license's
            transaction id and a hashed device id, nothing about files, and only on Macs with a commercial license.
        </li>
        <li>
            <strong>The S3 price table</strong>: public prices for estimating what an S3 operation costs, at most once a
            day and only for S3 users. It sends no user data.
        </li>
        <li>
            <strong>The image-search model download</strong> from Hugging Face, when a user turns on semantic image
            search: a download of the on-device model. Nothing is uploaded. (<code>DisableAI</code> does stop the local
            AI model download.)
        </li>
        <li>
            <strong>Feedback and newsletter signup</strong>: only when the user sends them.
        </li>
        <li><strong>Remote files</strong>: servers and devices the user connects to.</li>
    </ul>
    <DevTodo>
        Release timing: managed preferences ship in the first release after 0.50.0. This section, the gap lines it
        replaced, and the "IT can" sentences elsewhere on this page are only true from then, so publish them with
        that release. Then David runs plan M9 (the sample profile on a real Mac) before the
        <a href="https://github.com/vdavid/cmdr/issues/118">#118</a> boxes get ticked.
    </DevTodo>

    <h3 id="mdm-deploy">Deploying Cmdr</h3>
    <ul>
        <li>
            <strong>Installing</strong>: today Cmdr ships as a disk image (DMG) and a Homebrew cask. An installer package
            (<code>.pkg</code>), signed and notarized, is ready in the release pipeline and waits on its signing
            certificate. It installs Cmdr to <code>/Applications</code>, owned by the system, and runs no scripts.
        </li>
        <li>
            <strong>Updates on a managed Mac</strong>: when Cmdr sits in an <code>/Applications</code> folder the user
            can't write to, as after a package install, its updater asks for an administrator password. Where users
            aren't administrators, set <code>DisableUpdates</code> and push each new version from your MDM instead.
        </li>
        <li>
            <strong>Full Disk Access</strong>: upload the
            <a href="/mdm/cmdr-full-disk-access.mobileconfig" download>Full Disk Access profile</a> as a custom
            configuration profile (Jamf Pro, Kandji, Microsoft Intune, and Mosyle all take one). If your MDM has a
            privacy (PPPC) editor instead, add Cmdr with identifier <code>com.veszelovszki.cmdr</code>, identifier type
            Bundle ID, the <a href="#signing">code requirement</a> below, and "Full Disk Access"
            (<code>SystemPolicyAllFiles</code>) set to Allow.
        </li>
        <li>
            <strong>Only an MDM can grant it.</strong> macOS applies a privacy profile only when it comes from an MDM
            the Mac is enrolled in with the user's approval or through Apple Business Manager. Opening the file on a
            Mac doesn't install it.
        </li>
        <li>
            <strong>What else the profile covers</strong>: the Desktop, Documents, and Downloads folders, and network
            and removable volumes. Full Disk Access already includes them; they're listed separately so you can drop
            Full Disk Access and grant only those. It leaves out local network access, which isn't a privacy profile
            setting (macOS 27 can suggest it through the declarative app settings configuration), Photos and Music,
            which Cmdr only uses for icons and thumbnails, and Automation of Finder, which each user approves the first
            time they use Get info.
        </li>
        <li>
            <strong>On macOS 27</strong>, Apple marks privacy profiles as deprecated, and they still apply. Full Disk
            Access has no replacement setting yet.
        </li>
    </ul>
    <DevTodo>
        The pkg: once David adds the Developer ID Installer certificate (<code>docs/guides/releasing.md</code> § The
        installer package) and a release ships <code>Cmdr_X.Y.Z_universal.pkg</code>, change the "Installing" bullet
        to say releases include it, link it, and drop the matching "Not in place yet" line. The PPPC profile: test it
        on a real MDM-enrolled Mac (the profile installs, System Settings shows Cmdr under Full Disk Access as managed,
        and onboarding's step 1 shows the "already granted" variant), then drop that gap line and tick the box in
        <a href="https://github.com/vdavid/cmdr/issues/118">#118</a>.
    </DevTodo>

    <h2 id="eu">Does data leave the EU?</h2>
    <p>
        <strong>Yes.</strong> Rymdskottkärra AB is in Sweden, and much of the data stays in the EU, but not all of it:
    </p>
    <ul>
        <li>Downloads and updates come from GitHub (United States), which sees the IP address.</li>
        <li>
            Error reports, feedback, and signups create notifications in Discord, and error reports and feedback
            become issues on GitHub (both United States). An email address the user attached goes to GitHub only, in
            a comment that's deleted on a schedule, and never to Discord.
        </li>
        <li>
            Emails with license keys, and notification emails about reports and feedback, pass through Resend (a United
            States company).
        </li>
        <li>
            Emails we send from @getcmdr.com addresses leave through SMTP2Go, a New Zealand company. The EU recognizes
            New Zealand as giving adequate data protection, and SMTP2Go says it stores data of EEA customers only in
            the EEA.
        </li>
        <li>
            Cloudflare runs the API server on its global network. Its database and file storage are placed in Eastern
            Europe, but that placement isn't a contractual EU guarantee.
        </li>
        <li>Paddle, which handles payments, is in the United Kingdom.</li>
        <li>If a user sets up cloud AI, their data goes to wherever that provider runs.</li>
    </ul>
    <p>
        Usage stats (PostHog EU cloud), the website and the @getcmdr.com inbox (both self-hosted at Hetzner, Finland),
        and newsletter sending (AWS, Stockholm) stay in the EU.
    </p>

    <h2 id="subprocessors">Subprocessors</h2>
    <p>These companies process data on Cmdr's behalf.</p>
    {
        dataLocations.map((location) => (
            <>
                <h3>{location.name}</h3>
                <ul>
                    <li>
                        <strong>What</strong>: <Fragment set:html={location.what} />
                    </li>
                    <li>
                        <strong>Where</strong>: {location.where} ({euLabel[location.inEu]})
                    </li>
                </ul>
            </>
        ))
    }
    <p>
        Services with no user data: healthchecks.io and UptimeRobot (uptime monitoring), and GitGuardian (scans the
        source code for leaked secrets). Hugging Face serves optional model downloads that the user starts.
    </p>

    <h2 id="storage">What is stored where, and for how long</h2>
    <h3>On the user's Mac</h3>
    <p>
        Cmdr keeps its data in <code>~/Library/Application Support/com.veszelovszki.cmdr/</code>, its drive index in
        <code>~/Library/Caches/com.veszelovszki.cmdr/</code>, and its logs in
        <code>~/Library/Logs/com.veszelovszki.cmdr/</code>. Cmdr doesn't add its own encryption, so this data is as safe
        as the Mac's FileVault. It includes:
    </p>
    <ul>
        <li>
            An index of <strong>every file and folder name and path</strong> on each indexed drive, including network
            shares. It lives in <code>~/Library/Caches/com.veszelovszki.cmdr/drive-index/</code>, so Time Machine
            doesn't back it up, and Cmdr rebuilds it if it's deleted.
        </li>
        <li>For image search: text read from images (OCR), tags, and image fingerprints.</li>
        <li>A log of every copy, move, rename, and delete, with paths (up to 3 GB by default).</li>
        <li>Search and selection history, AI chats, and the AI assistant's notes.</li>
        <li>Server addresses and usernames for saved network connections, settings, and the license key.</li>
        <li>
            Logs with full paths, up to 200 MB by default. Paths are cleaned only when a report is sent, not in the
            local file.
        </li>
    </ul>
    <p>
        <strong>Passwords and API keys</strong> (for SMB, SFTP, WebDAV, and cloud AI) are stored in the macOS
        Keychain, never in Cmdr's settings files.
    </p>

    <h3>On Cmdr's servers</h3>
    <p>A daily job on the API server deletes data on this schedule:</p>
    <ul>
        {
            serverRetention.map((entry) => (
                <li>
                    <strong>{entry.what}</strong>: <Fragment set:html={entry.rule} />
                </li>
            ))
        }
    </ul>
    <p>
        Nothing in Cmdr's code deletes old Discord notifications, emails in the @getcmdr.com inbox, or Resend's and
        SMTP2Go's delivery logs.
    </p>
    <DevTodo>
        Confirm Cmdr is on PostHog's free plan (events kept one year; a paid plan keeps them seven).
    </DevTodo>

    <h2 id="signing">Signing, notarization, and updates</h2>
    <ul>
        <li>
            <strong>Code signing</strong>: Developer ID Application: Rymdskottkarra AB, Team ID <code>83H6YAQMNP</code>,
            bundle id <code>com.veszelovszki.cmdr</code>. It runs on macOS 10.15 and later.
        </li>
        <li>
            <strong>Notarized by Apple</strong>, with the ticket stapled to the app. <code>spctl</code> reports
            <code>source=Notarized Developer ID</code>.
        </li>
        <li>
            <strong>Hardened runtime</strong> is on, and the released version {verifiedAgainst.version} has no
            entitlements at all.
        </li>
        <li>
            <strong>Code requirement</strong> for a PPPC profile (to grant Full Disk Access through MDM):
            <code>{codeRequirement}</code>. It stays the same across updates, so a Full Disk Access grant survives them.
            The <a href="/mdm/cmdr-full-disk-access.mobileconfig" download>Full Disk Access profile</a> uses it.
        </li>
        <li>
            <strong>Downloads</strong>: a disk image (DMG) from GitHub Releases, or the Homebrew cask. Each release
            publishes SHA-256 checksums. There's no <code>.pkg</code> installer yet (<a href="#mdm-deploy"
                >deploying Cmdr</a
            >).
        </li>
        <li>
            <strong>Build provenance</strong>: every file in a release carries a signed
            attestation (<a href="https://slsa.dev/spec/v1.0/levels#build-l2">SLSA Build Level 2</a>) saying which
            commit and which GitHub workflow built it. To check a download, run
            <code>gh attestation verify &lt;file&gt; --repo vdavid/cmdr</code> with the
            <a href="https://cli.github.com/">GitHub CLI</a>.
        </li>
        <li>
            <strong>SBOMs</strong>: each release also includes software bills of materials in CycloneDX format, one
            for the Rust dependencies of each processor type and one for the JavaScript dependencies. They're signed and
            tied to the builds they describe, the same way.
        </li>
        <li>
            <strong>Updates</strong>: the app downloads the new version from GitHub and checks its Ed25519 (minisign)
            signature against a public key built into the app, before writing anything to disk. It only installs a
            version newer than the one running, so an attacker can't force a downgrade. macOS checks the Apple
            signature again when the app starts. If the app is in an <code>/Applications</code> folder the user can't
            write to, the update asks for an administrator password.
        </li>
        <li>
            <strong>Turning updates off</strong>: per user in Settings &gt; Updates &amp; privacy. IT can turn them
            off for everyone or hold Cmdr at a version (<a href="#mdm">central management</a>).
        </li>
        <li>
            <strong>Signing keys</strong>: the release build signs with keys stored as GitHub secrets. The GitHub
            account that controls them signs in with two-factor authentication, using hardware security keys. Every
            signing key also has an encrypted backup outside GitHub.
        </li>
    </ul>
    <DevTodo>
        The entitlements (none) and the code requirement above were read from the 0.50.0 release with
        <code>codesign -d --entitlements -</code> and <code>codesign -d -r-</code>; the requirement matched 0.50.0 in
        <code>/Applications</code> again on 2026-10-07 (<code>codesign -v -R=</code>). Nobody has tested the PPPC
        profile on a real MDM yet. Once a release ships <code>Cmdr_X.Y.Z.intoto.jsonl</code> (the release workflow
        attaches it from the next release on), add to the "Build provenance" bullet: "The same provenance is attached
        to each release as a file ending in <code>.intoto.jsonl</code>."
    </DevTodo>

    <h2 id="permissions">Sandbox and permissions</h2>
    <p>
        Cmdr is <strong>not App Sandboxed</strong> and isn't on the Mac App Store. The sandbox only lets an app open
        files the user picks one by one, which doesn't work for a file manager. Cmdr runs as the logged-in user and can
        reach what that user can reach.
    </p>
    <p>
        <strong>Full Disk Access</strong>: during first-time setup, Cmdr asks the user to grant it in System Settings,
        so macOS doesn't ask separately for every protected folder. The user can say no; Cmdr then works with the
        usual macOS prompts. IT can grant it ahead of time through MDM (<a href="#mdm-deploy">deploying Cmdr</a>).
    </p>
    <p>Other macOS permissions Cmdr may ask for, and why:</p>
    <ul>
        <li><strong>Desktop, Documents, and Downloads folders</strong>: to browse them.</li>
        <li><strong>Network volumes and removable volumes</strong>: to browse network shares, USB drives, and SD cards.</li>
        <li><strong>Local network</strong>: to connect to SMB file servers directly and find them on the network.</li>
        <li><strong>Music and Photos</strong>: to read file metadata for icons and thumbnails. Cmdr doesn't read the libraries.</li>
        <li>
            <strong>Automation of Finder</strong>: to open Finder's Get Info window for a file, the first time someone
            uses Get info. Cmdr asks Finder for nothing else, and it needs no entitlement for this.
        </li>
    </ul>
    <p>Other things Cmdr does on the system that a reviewer might notice:</p>
    <ul>
        <li>
            While an Android phone or camera is connected over USB (MTP), Cmdr pauses the macOS
            <code>ptpcamerad</code> service, which would otherwise take the device, and starts it again afterwards.
        </li>
        <li>
            It can read an SMB password that another app saved in the login keychain, only when the user connects,
            and macOS asks the user first.
        </li>
        <li>
            The optional local AI runs <code>llama-server</code> (from llama.cpp, SHA-256 pinned at build time and
            signed with Cmdr's certificate) as a separate process, listening on <code>127.0.0.1</code> only.
        </li>
        <li>
            The optional MCP server, which lets outside AI tools control Cmdr, is off by default. When on, it listens
            on <code>127.0.0.1</code> only. Deleting and other actions that skip Cmdr's confirmation need an access
            token; other commands are open to any program on the same Mac.
        </li>
        <li>
            Cmdr opens no port that other machines can connect to: everything it listens on is <code>127.0.0.1</code>.
            The one exception is Bonjour (mDNS, UDP port 5353, over IPv4 and IPv6), which finds SMB servers on the
            local network. Firewall tools like Little Snitch may list the answers from other devices on the network as
            incoming connections to Cmdr.
        </li>
    </ul>

    <h2 id="ai">AI features and your files</h2>
    <p>
        <strong>AI is off by default.</strong> Cmdr has no AI service of its own and never sees prompts or answers. A
        user can pick:
    </p>
    <ul>
        <li>
            <strong>Local AI</strong>: Cmdr's own model, which runs on the Mac (downloaded on request). Nothing leaves
            the Mac.
        </li>
        <li>
            <strong>Cloud AI</strong>, with the user's own API key where the service needs one: OpenAI, Anthropic, Google Gemini, Groq, Together AI,
            Fireworks AI, Mistral, OpenRouter, DeepSeek, Qwen (Alibaba), xAI, Perplexity, Azure OpenAI, a custom
            endpoint, or an Ollama or LM Studio server, which can run on the same Mac or on another machine. The app
            talks straight to that provider, under that provider's terms. The key is kept in the macOS
            Keychain, and Cmdr won't send it over plain HTTP except to the same Mac.
        </li>
    </ul>
    <p>
        Nothing reaches a cloud AI service until the user turns on "Allow cloud AI" in Settings, which lists what each feature sends. The app's backend enforces this for every AI feature. Cmdr's own
        on-device model needs no switch, because nothing leaves the Mac.
    </p>
    <p>With cloud AI, this is what reaches the provider:</p>
    <ul>
        <li>
            <strong>Ask Cmdr</strong> (the assistant): file and folder names, paths, sizes, and dates. When the user's
            question needs it, also parts of text files, text from PDF pages, archive listings, photo metadata (which
            can include GPS location), and text read from images. The assistant can't change or delete files.
        </li>
        <li>
            <strong>Folder name suggestions, select-by-description, and natural-language search</strong>: up to a few
            hundred file and folder names from the current folder, or the search text.
        </li>
    </ul>
    <p>
        Text recognition in images, image tags, and image search always run on the Mac, using Apple's built-in
        frameworks. IT can turn AI off, allow only on-device AI, or limit which hosts cloud AI may reach
        (<a href="#mdm">central management</a>).
    </p>

    <h2 id="development">How Cmdr is built</h2>
    <p>
        The full answer to "Do you have a secure development lifecycle, and do you keep the software up to date?",
        stage by stage and with measured numbers, is on its own page:
        <a href="/trust/development">How Cmdr is built and kept up to date</a>. In short:
    </p>
    <ul>
        <li>
            The code that touches files, the network, and the system is Rust. {codeCounts.checks} automated checks,
            including about {fmt(Math.round(codeCounts.rustTests / 100) * 100)} Rust tests with deliberately hostile
            cases, run during development and again on GitHub after each change.
        </li>
        <li>
            Development is AI-assisted. One person owns every change; as a one-person company, there's no
            second-person code review.
        </li>
        <li>
            A whole-app <a href="https://github.com/vdavid/cmdr/blob/main/docs/threat-model.md">threat model</a> on
            GitHub lists what Cmdr protects, from whom, where the trust boundaries run, what stops each threat, and the
            risks that remain.
        </li>
        <li>
            {releaseCadence.releases} releases in the last {devWindow.days} days. New dependency versions wait three
            days before use, and known vulnerabilities in dependencies are scanned for automatically.
        </li>
        <li>
            The app installs updates by itself. About {updateAdoption.firstDay.percent}% of active installs run a new
            release within 24 hours.
        </li>
    </ul>
    <p>
        Data safety (how Cmdr avoids losing files during copies and deletes) has its own page:
        <a href="/data-safety">How Cmdr protects your files</a>.
    </p>

