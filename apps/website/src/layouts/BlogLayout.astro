---
import Layout from './Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import BlogImageClick from '../components/BlogImageClick.astro'
import BlogCompareSlider from '../components/BlogCompareSlider.astro'
// Blog media (slider/lightbox/theme images) CSS — imported here, not in global.css, so it only
// inlines into blog pages. Unscoped (plain import, not a <style>) to preserve its `:root` specificity.
import '../styles/blog-media.css'

interface Props {
    title: string
    description: string
    date: string
    /** ISO date of the last meaningful content update; shown more prominently than `date`. */
    updated?: string
    ogImage?: string
    noindex?: boolean
}

const { title, description, date, updated, ogImage, noindex = false } = Astro.props

const formatDate = (isoDate: string) =>
    new Date(isoDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
const formattedDate = formatDate(date)

const blogPostingSchema: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: description,
    datePublished: date,
    ...(updated && { dateModified: updated }),
    author: {
        '@type': 'Person',
        name: 'David Veszelovszki',
        url: 'https://getcmdr.com',
    },
    publisher: {
        '@type': 'Organization',
        name: 'Cmdr',
        url: 'https://getcmdr.com',
        logo: 'https://getcmdr.com/logo-512.png',
    },
    url: Astro.url.href,
}
if (ogImage) {
    blogPostingSchema.image = new URL(ogImage, Astro.site).href
}
---

<Layout title={`${title} | Cmdr blog`} description={description} ogImage={ogImage} noindex={noindex}>
    <Header />
    <main class="mx-auto max-w-3xl px-6 pt-32 pb-24">
        <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
        <header class="mb-12">
            {
                updated ? (
                    <p class="text-sm text-text-tertiary">
                        <time class="font-semibold text-text-secondary" datetime={updated}>
                            Updated on {formatDate(updated)}
                        </time>
                        {' (First published '}
                        <time datetime={date}>{formattedDate}</time>)
                    </p>
                ) : (
                    <time class="text-sm text-text-tertiary" datetime={date}>
                        {formattedDate}
                    </time>
                )
            }
            <h1 class="mt-2 mb-4 text-4xl font-bold tracking-tight text-text-primary">
                {title}
            </h1>
            <p class="text-lg text-text-secondary">
                {description}
            </p>
        </header>

        <article class="blog-content">
            <slot />
        </article>
    </main>
    <Footer />
</Layout>

<BlogImageClick />
<BlogCompareSlider />

<style>
    @import '../styles/blog-prose.css';
</style>
