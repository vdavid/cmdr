---
import DownloadButton from './DownloadButton.astro'
import HeroLiveDemo from './HeroLiveDemo.astro'

const currentYear = new Date().getFullYear()
---

<section class="hero-section relative px-3 pt-16 sm:px-6">
    <div
        class="hero-card relative mx-auto mt-4 max-w-360 overflow-hidden rounded-3xl border border-border-subtle bg-surface px-6 pt-10 pb-12 sm:rounded-[28px] sm:px-10 sm:pt-16 lg:min-h-175 lg:px-14 lg:pt-20 lg:pb-16"
    >
        <!-- Two soft color pools, the way the card is lit: warm top-left, cool bottom-center. -->
        <div class="hero-pool hero-pool--warm" aria-hidden="true"></div>
        <div class="hero-pool hero-pool--cool" aria-hidden="true"></div>

        <div class="hero-content relative z-10 lg:max-w-[40%]">
            <!-- Open-beta eyebrow - Step 1 -->
            <a
                href="/features"
                class="animate-blur-in stagger-1 mb-5 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-sm font-medium text-accent-text transition-colors hover:bg-accent/20"
            >
                Now in open beta
                <span aria-hidden="true">&rarr;</span>
            </a>

            <!-- Headline - Steps 2 & 3 -->
            <h1 class="mb-6 text-3xl/tight font-bold tracking-tight min-[1400px]:text-5xl md:text-4xl">
                <span class="animate-blur-in stagger-2 inline-block">Finally, a file manager</span>
                <span class="animate-blur-in stagger-3 gradient-text inline-block">from {currentYear}!</span>
            </h1>

            <!-- Subheadline - Step 4: a lead line, the two "plus" points as a real list, then the
                 closer. The list owns the indent and the line breaks, so the copy survives being
                 re-worded or translated. -->
            <div class="animate-blur-in stagger-4 mb-10 text-lg/relaxed text-text-secondary">
                <p>The standard two-pane file manager experience we love</p>
                <ul class="mt-1 space-y-1 ps-6">
                    <li>
                        <em class="text-accent-text">plus</em> a drive index for instant search and folder sizes
                    </li>
                    <li>
                        <em class="text-accent-text">plus</em> a bunch of (optional!) AI features to organize your
                        files.
                    </li>
                </ul>
                <p class="mt-4">Built in Rust, free for personal use.</p>
            </div>

            <!-- CTA Button + Homebrew hint - Steps 5 & 6: the hint sits beside the button (vertically
                 centered) when it fits, and stacks below it on narrow viewports. -->
            <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center">
                <DownloadButton variant="hero" class="animate-blur-in stagger-5 w-full sm:w-auto" />
                <a
                    href="#homebrew"
                    data-brew-jump
                    class="animate-blur-in stagger-6 inline-flex items-center gap-1.5 self-center text-sm text-text-tertiary underline decoration-border underline-offset-4 transition-colors hover:text-accent-text hover:decoration-accent sm:self-auto"
                >
                    or Homebrew
                    <svg
                        class="size-3.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M12 5v14M19 12l-7 7-7-7"></path>
                    </svg>
                </a>
            </div>

            <!-- Pricing hint - Step 7 -->
            <p class="animate-blur-in stagger-7 mt-8 text-sm text-text-tertiary">
                <a
                    href="https://github.com/vdavid/cmdr"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-muted hover:text-accent-text">Source-available</a
                > · Free for personal use · $59 once for work
            </p>
        </div>

        <HeroLiveDemo />
    </div>
</section>

<style>
    /* Text blur-in animation - global so it applies to classes */
    :global(.animate-blur-in) {
        animation: blur-in 1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    /* Stagger delays for 7-step animation (100ms apart, overlapping) */
    :global(.stagger-1) {
        animation-delay: 0ms;
    }
    :global(.stagger-2) {
        animation-delay: 100ms;
    }
    :global(.stagger-3) {
        animation-delay: 200ms;
    }
    :global(.stagger-4) {
        animation-delay: 300ms;
    }
    :global(.stagger-5) {
        animation-delay: 400ms;
    }
    :global(.stagger-6) {
        animation-delay: 500ms;
    }
    :global(.stagger-7) {
        animation-delay: 600ms;
    }

    @keyframes blur-in {
        from {
            opacity: 0;
            filter: blur(10px);
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            filter: blur(0);
            transform: translateY(0);
        }
    }

    .hero-pool {
        pointer-events: none;
        position: absolute;
        border-radius: 9999px;
    }

    .hero-pool--warm {
        top: -6rem;
        left: -6rem;
        width: 480px;
        height: 480px;
        background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent);
    }

    .hero-pool--cool {
        right: 30%;
        bottom: -10rem;
        width: 520px;
        height: 520px;
        background: radial-gradient(closest-side, color-mix(in srgb, var(--color-icon-soon) 14%, transparent), transparent);
    }

    @keyframes fade-in-only {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(.animate-blur-in) {
            animation: fade-in-only 0.5s ease both;
            filter: none;
            transform: none;
        }
    }
</style>
