---
/**
 * A short, muted, looping screen recording of the app, framed as a macOS window.
 *
 * - Picks the light or dark recording to match the site theme, and follows the theme toggle live.
 * - Loads and plays only while on screen; pauses offscreen. A play/pause button is always reachable
 *   (WCAG 2.2.2), and with `prefers-reduced-motion` the clip waits on its poster until clicked.
 * - A thin accent line along the bottom shows the playback position. The whole frame is a slider:
 *   click or tap toggles play, a horizontal drag scrubs (pausing only while dragging), and when
 *   focused, the arrow keys, Page Up/Down, Home, and End seek while Space toggles play.
 * - The recordings have no alpha channel, so the rounded corners and the shadow are CSS.
 * - A clip missing from `public/clips/` renders a placeholder card that says so.
 *
 * File contract and availability rules: `src/build/product-clips.ts`.
 */
import Icon from './icons/Icon.astro'
import { getProductClip, type ClipSlug } from '../build/product-clips'

interface Props {
    slug: ClipSlug
    /**
     * What the clip shows, for screen readers, as visually hidden text that describes the position
     * slider. The video itself stays `aria-hidden`: html-validate rejects naming a `<video>`
     * (`aria-label` and `aria-labelledby` alike, rule aria-label-misuse), and the slider and the
     * play/pause button are the clip's controls.
     */
    label: string
    caption?: string
    /** Attribution for third-party media the recording shows, rendered as a quiet line under the clip. */
    credit?: ClipCredit
    class?: string
}

interface ClipCredit {
    /** What the media is, like "Photo". */
    kind: string
    title: string
    titleHref: string
    author: string
    license: string
    licenseHref: string
}

const { slug, label, caption, credit, class: className } = Astro.props

const placeholderTitles: Record<ClipSlug, string> = {
    'copy-rollback': 'Copy, pause, and roll back',
    'ops-queue': 'The operation queue',
    'multi-rename': 'Multi-rename',
    search: 'Natural-language search',
    'language-switch': 'Switching languages',
    viewer: 'The file viewer',
    settings: 'Settings',
}

const clip = getProductClip(slug)
// A page shows each clip once, so the slug keeps the id unique.
const descriptionId = `clip-${slug}-description`
---

<figure class:list={['product-clip', className]}>
    {
        clip ? (
            <div
                class="clip-window"
                style={`aspect-ratio: ${clip.width} / ${clip.height}`}
                data-product-clip
                data-state="paused"
                data-av1-light={clip.files.light.av1}
                data-av1-dark={clip.files.dark.av1}
                data-h264-light={clip.files.light.h264}
                data-h264-dark={clip.files.dark.h264}
                data-duration={clip.duration}
            >
                <img
                    class="clip-poster clip-poster--light"
                    src={clip.files.light.poster}
                    width={clip.width}
                    height={clip.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                />
                <img
                    class="clip-poster clip-poster--dark"
                    src={clip.files.dark.poster}
                    width={clip.width}
                    height={clip.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                />
                <video
                    class="clip-video"
                    width={clip.width}
                    height={clip.height}
                    muted
                    loop
                    playsinline
                    disablepictureinpicture
                    preload="none"
                    aria-hidden="true"
                />
                <span class="sr-only" id={descriptionId} data-clip-description>
                    {label}
                </span>
                <div
                    class="clip-scrub"
                    role="slider"
                    tabindex="0"
                    aria-label="Clip position"
                    aria-describedby={descriptionId}
                    aria-keyshortcuts="Space"
                    aria-valuemin="0"
                    aria-valuemax={Math.round(clip.duration)}
                    aria-valuenow="0"
                    aria-valuetext={`0 of ${Math.round(clip.duration)} seconds`}
                    data-clip-scrub
                >
                    <span class="clip-progress" aria-hidden="true">
                        <span class="clip-progress__fill" data-clip-progress />
                    </span>
                </div>
                <button type="button" class="clip-toggle" data-clip-toggle aria-label="Play clip">
                    <Icon name="play" size={16} class="clip-toggle__play" />
                    <Icon name="pause" size={16} class="clip-toggle__pause" />
                </button>
            </div>
        ) : (
            <div class="clip-placeholder" role="img" aria-label={`Placeholder for a clip: ${label}`}>
                <span class="clip-placeholder__pill">Placeholder</span>
                <Icon name="clapperboard" size={32} />
                <span class="clip-placeholder__title">{placeholderTitles[slug]}</span>
                <span class="clip-placeholder__note">Clip not recorded yet</span>
            </div>
        )
    }
    {
        (caption || credit) && (
            <figcaption>
                {caption && <span class="clip-caption">{caption}</span>}
                {credit && (
                    <span class="clip-credit" data-clip-credit>
                        {credit.kind}: “<a href={credit.titleHref}>{credit.title}</a>” by {credit.author},{' '}
                        <a href={credit.licenseHref}>{credit.license}</a>
                    </span>
                )}
            </figcaption>
        )
    }
</figure>

<style>
    .product-clip {
        margin: 0;
        /* Window shadow, tuned per theme below. Videos carry no alpha, so this IS the window shadow. */
        --clip-shadow:
            0 0 0 1px rgb(0 0 0 / 0.5), 0 2px 6px rgb(0 0 0 / 0.3), 0 24px 48px -12px rgb(0 0 0 / 0.55);
        --clip-rim: color-mix(in srgb, var(--color-text-primary) 12%, transparent);
    }

    @media (prefers-color-scheme: light) {
        :global(:root:not([data-theme='dark'])) .product-clip {
            --clip-shadow:
                0 0 0 1px rgb(0 0 0 / 0.12), 0 2px 6px rgb(0 0 0 / 0.08), 0 24px 48px -16px rgb(0 0 0 / 0.28);
            --clip-rim: transparent;
        }
    }

    :global(:root[data-theme='light']) .product-clip {
        --clip-shadow:
            0 0 0 1px rgb(0 0 0 / 0.12), 0 2px 6px rgb(0 0 0 / 0.08), 0 24px 48px -16px rgb(0 0 0 / 0.28);
        --clip-rim: transparent;
    }

    .clip-window {
        position: relative;
        overflow: hidden;
        border-radius: clamp(8px, 1.4vw, 12px);
        background: var(--color-surface);
        box-shadow: var(--clip-shadow);
        isolation: isolate;
    }

    /* The macOS window's hairline highlight, drawn above the video so it never gets covered. */
    .clip-window::after {
        content: '';
        pointer-events: none;
        position: absolute;
        inset: 0;
        z-index: 2;
        border-radius: inherit;
        box-shadow: inset 0 0 0 1px var(--clip-rim);
    }

    .clip-poster,
    .clip-video {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .clip-video {
        opacity: 0;
        transition: opacity 250ms ease;
    }

    .clip-window[data-ready] .clip-video {
        opacity: 1;
    }

    /* Show only the poster matching the theme. Lazy images that aren't rendered never download. */
    .clip-poster--light {
        display: none;
    }

    @media (prefers-color-scheme: light) {
        :global(:root:not([data-theme='dark'])) .clip-poster--dark {
            display: none;
        }
        :global(:root:not([data-theme='dark'])) .clip-poster--light {
            display: block;
        }
    }

    :global(:root[data-theme='light']) .clip-poster--dark {
        display: none;
    }
    :global(:root[data-theme='light']) .clip-poster--light {
        display: block;
    }

    /* The whole frame is the scrub surface. `pan-y` keeps vertical page scrolling on touch while a
       horizontal drag reaches the slider. */
    .clip-scrub {
        position: absolute;
        inset: 0;
        z-index: 1;
        cursor: grab;
        touch-action: pan-y;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    .clip-scrub:focus-visible {
        outline: none;
    }

    .clip-window[data-scrubbing] .clip-scrub {
        cursor: grabbing;
    }

    /* The ring goes on the window: the slider sits inside `overflow: hidden`, which would clip it. */
    .clip-window:has(.clip-scrub:focus-visible) {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
    }

    .clip-progress {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        height: 2px;
        background: color-mix(in srgb, var(--color-text-primary) 10%, transparent);
        opacity: 0;
        transition:
            opacity 250ms ease,
            height 150ms ease;
    }

    .clip-window[data-ready] .clip-progress {
        opacity: 1;
    }

    /* Thicker while it's being handled, so the drag has something to look at. */
    .clip-window[data-scrubbing] .clip-progress,
    .clip-window:has(.clip-scrub:focus-visible) .clip-progress {
        height: 4px;
    }

    .clip-progress__fill {
        display: block;
        width: 100%;
        height: 100%;
        background: color-mix(in srgb, var(--color-accent) 80%, transparent);
        transform: scaleX(0);
        transform-origin: left;
    }

    .clip-toggle {
        position: absolute;
        right: 12px;
        bottom: 12px;
        z-index: 3;
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: color-mix(in srgb, var(--color-surface-elevated) 88%, transparent);
        backdrop-filter: blur(8px);
        cursor: pointer;
        opacity: 0;
        transition: opacity 200ms ease;
    }

    .clip-toggle :global(.icon) {
        color: var(--color-text-primary);
    }

    /* Visible while hovering, when focused, and whenever the clip sits paused. */
    .clip-window:hover .clip-toggle,
    .clip-toggle:focus-visible,
    .clip-scrub:focus-visible ~ .clip-toggle,
    .clip-window[data-state='paused'] .clip-toggle {
        opacity: 1;
    }

    .clip-toggle:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
    }

    .clip-window[data-state='playing'] .clip-toggle :global(.clip-toggle__play),
    .clip-window[data-state='paused'] .clip-toggle :global(.clip-toggle__pause) {
        display: none;
    }

    .clip-placeholder {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        aspect-ratio: 16 / 10;
        padding: 24px;
        border: 1.5px dashed var(--color-border);
        border-radius: clamp(8px, 1.4vw, 12px);
        text-align: center;
        background:
            radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent 60%),
            var(--color-surface);
    }

    .clip-placeholder__pill {
        position: absolute;
        top: 12px;
        left: 12px;
        padding: 2px 10px;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-text-tertiary);
    }

    .clip-placeholder__title {
        font-weight: 600;
        color: var(--color-text-primary);
    }

    .clip-placeholder__note {
        font-size: 0.875rem;
        color: var(--color-text-tertiary);
    }

    .clip-credit {
        display: block;
        margin-top: 10px;
        font-size: 0.75rem;
        line-height: 1.5;
        color: var(--color-text-tertiary);
    }

    .clip-credit a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
        text-underline-offset: 2px;
    }

    .clip-credit a:hover {
        color: var(--color-text-secondary);
    }

    .clip-caption {
        display: block;
        margin-top: 14px;
        font-size: 0.9375rem;
        line-height: 1.5;
        color: var(--color-text-secondary);
    }

    @media (prefers-reduced-motion: reduce) {
        .clip-video,
        .clip-toggle,
        .clip-progress {
            transition: none;
        }
    }
</style>

<script>
    type Theme = 'light' | 'dark'

    interface Clip {
        root: HTMLElement
        video: HTMLVideoElement
        button: HTMLButtonElement
        visible: boolean
        /** Whether the clip should play while on screen: autoplay, unless reduced motion or the visitor paused it. */
        wantsPlay: boolean
        /** Theme of the loaded sources; `null` until the clip first comes on screen. */
        theme: Theme | null
        slider: HTMLElement
        progress: HTMLElement
        /** The whole second last written to `aria-valuenow`, so a 60 fps redraw doesn't churn the a11y tree. */
        announcedSecond: number
        /** The animation frame driving the progress line while playing, if any. */
        frame: number | null
        drag: Drag | null
        /** Where to seek once the metadata arrives, for a seek made before the clip loaded. */
        pendingSeek: number | null
    }

    interface Drag {
        pointerId: number
        startX: number
        startTime: number
        wasPlaying: boolean
        /** False until the pointer travels past `DRAG_THRESHOLD_PX`; a press that never does is a click. */
        moved: boolean
    }

    const AV1_TYPE = 'video/mp4; codecs="av01.0.08M.08"'
    const DRAG_THRESHOLD_PX = 6
    const ARROW_STEP_S = 1
    const PAGE_STEP_S = 5
    /** Seeking to the very end of a looping video lands on its first frame, so End stops just short. */
    const END_MARGIN_S = 0.05
    const clips = new Set<Clip>()
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const prefersLight = window.matchMedia('(prefers-color-scheme: light)')

    function activeTheme(): Theme {
        const explicit = document.documentElement.dataset.theme
        if (explicit === 'light' || explicit === 'dark') return explicit
        return prefersLight.matches ? 'light' : 'dark'
    }

    function source(src: string, type: string): HTMLSourceElement {
        const el = document.createElement('source')
        el.src = src
        el.type = type
        return el
    }

    /** Points the video at the active theme's files, keeping its position and play state. */
    function loadSources(clip: Clip): void {
        const theme = activeTheme()
        if (clip.theme === theme) return
        const { video, root } = clip
        const resumeAt = video.currentTime
        const wasPlaying = !video.paused
        const av1 = theme === 'light' ? root.dataset.av1Light : root.dataset.av1Dark
        const h264 = theme === 'light' ? root.dataset.h264Light : root.dataset.h264Dark
        const sources: HTMLSourceElement[] = []
        if (av1) sources.push(source(av1, AV1_TYPE))
        if (h264) sources.push(source(h264, 'video/mp4'))
        video.replaceChildren(...sources)
        clip.theme = theme
        delete root.dataset.ready
        video.preload = 'auto'
        video.load()
        if (resumeAt > 0) {
            video.addEventListener(
                'loadedmetadata',
                () => {
                    video.currentTime = resumeAt
                },
                { once: true },
            )
        }
        if (wasPlaying) play(clip)
    }

    function play(clip: Clip): void {
        loadSources(clip)
        clip.video.play().catch(() => {
            // Autoplay refused (data saver, an old browser policy): stay on the poster with the play button showing.
            syncState(clip)
        })
    }

    function syncState(clip: Clip): void {
        const paused = clip.video.paused
        clip.root.dataset.state = paused ? 'paused' : 'playing'
        clip.button.setAttribute('aria-label', paused ? 'Play clip' : 'Pause clip')
        if (paused || reducedMotion.matches) stopFrames(clip)
        else startFrames(clip)
    }

    /** Seconds; the manifest's value until the video's own metadata arrives. */
    function duration(clip: Clip): number {
        const fromVideo = clip.video.duration
        return Number.isFinite(fromVideo) && fromVideo > 0 ? fromVideo : Number(clip.root.dataset.duration) || 0
    }

    function renderProgress(clip: Clip): void {
        const total = duration(clip)
        const now = clip.video.currentTime
        const fraction = total > 0 ? Math.min(1, now / total) : 0
        clip.progress.style.transform = `scaleX(${fraction})`
        const second = Math.round(now)
        if (second === clip.announcedSecond) return
        clip.announcedSecond = second
        clip.slider.setAttribute('aria-valuenow', String(second))
        clip.slider.setAttribute('aria-valuetext', `${second} of ${Math.round(total)} seconds`)
    }

    /**
     * A smooth line needs a redraw per frame, so it runs only while the clip plays. With reduced motion
     * the line steps on `timeupdate` (a few times a second) instead of gliding.
     */
    function startFrames(clip: Clip): void {
        if (clip.frame !== null) return
        const tick = () => {
            renderProgress(clip)
            clip.frame = requestAnimationFrame(tick)
        }
        clip.frame = requestAnimationFrame(tick)
    }

    function stopFrames(clip: Clip): void {
        if (clip.frame === null) return
        cancelAnimationFrame(clip.frame)
        clip.frame = null
    }

    /** Seeks to `seconds`, loading the sources first when the clip hasn't come on screen yet. */
    function seekTo(clip: Clip, seconds: number): void {
        const { video } = clip
        const go = (to: number) => {
            video.currentTime = Math.max(0, Math.min(to, duration(clip) - END_MARGIN_S))
            renderProgress(clip)
        }
        if (video.readyState >= HTMLMediaElement.HAVE_METADATA) {
            go(seconds)
            return
        }
        // A drag fires many seeks before the metadata lands; only the latest one matters.
        const firstWait = clip.pendingSeek === null
        clip.pendingSeek = seconds
        if (!firstWait) return
        video.addEventListener(
            'loadedmetadata',
            () => {
                if (clip.pendingSeek !== null) go(clip.pendingSeek)
                clip.pendingSeek = null
            },
            { once: true },
        )
        loadSources(clip)
    }

    function apply(clip: Clip): void {
        // A drag owns the play state until it ends, then restores it itself.
        if (clip.drag?.moved) return
        if (clip.visible && clip.wantsPlay) play(clip)
        else if (!clip.video.paused) clip.video.pause()
    }

    const visibility = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                const clip = [...clips].find((c) => c.root === entry.target)
                if (!clip) continue
                clip.visible = entry.isIntersecting
                apply(clip)
            }
        },
        { rootMargin: '120px 0px', threshold: 0.15 },
    )

    function bind(root: HTMLElement): void {
        const video = root.querySelector('video')
        const button = root.querySelector<HTMLButtonElement>('[data-clip-toggle]')
        const slider = root.querySelector<HTMLElement>('[data-clip-scrub]')
        const progress = root.querySelector<HTMLElement>('[data-clip-progress]')
        if (!video || !button || !slider || !progress) return
        const clip: Clip = {
            root,
            video,
            button,
            visible: false,
            wantsPlay: !reducedMotion.matches,
            theme: null,
            slider,
            progress,
            announcedSecond: 0,
            frame: null,
            drag: null,
            pendingSeek: null,
        }
        clips.add(clip)
        root.dataset.bound = ''

        const toggle = () => {
            clip.wantsPlay = clip.video.paused
            if (clip.wantsPlay) play(clip)
            else clip.video.pause()
        }
        button.addEventListener('click', toggle)
        video.addEventListener('play', () => syncState(clip))
        video.addEventListener('pause', () => syncState(clip))
        video.addEventListener('loadeddata', () => {
            root.dataset.ready = ''
            renderProgress(clip)
        })
        video.addEventListener('seeked', () => renderProgress(clip))
        video.addEventListener('timeupdate', () => {
            if (clip.frame === null) renderProgress(clip)
        })

        // Press and release in place toggles play; a horizontal drag scrubs relative to where it
        // started (the frame's full width spans the whole clip), pausing only while it lasts.
        slider.addEventListener('pointerdown', (event) => {
            if (event.pointerType === 'mouse' && event.button !== 0) return
            clip.drag = {
                pointerId: event.pointerId,
                startX: event.clientX,
                startTime: video.currentTime,
                wasPlaying: !video.paused,
                moved: false,
            }
            slider.setPointerCapture(event.pointerId)
        })
        slider.addEventListener('pointermove', (event) => {
            const drag = clip.drag
            if (!drag || drag.pointerId !== event.pointerId) return
            const dx = event.clientX - drag.startX
            if (!drag.moved) {
                if (Math.abs(dx) < DRAG_THRESHOLD_PX) return
                drag.moved = true
                root.dataset.scrubbing = ''
                video.pause()
            }
            seekTo(clip, drag.startTime + (dx / slider.clientWidth) * duration(clip))
        })
        const endDrag = (event: PointerEvent, completed: boolean) => {
            const drag = clip.drag
            if (!drag || drag.pointerId !== event.pointerId) return
            clip.drag = null
            if (slider.hasPointerCapture(event.pointerId)) slider.releasePointerCapture(event.pointerId)
            if (!drag.moved) {
                if (completed) toggle()
                return
            }
            delete root.dataset.scrubbing
            if (drag.wasPlaying && clip.visible) play(clip)
        }
        slider.addEventListener('pointerup', (event) => endDrag(event, true))
        // The browser took the gesture over (a vertical swipe became a page scroll): no toggle.
        slider.addEventListener('pointercancel', (event) => endDrag(event, false))

        slider.addEventListener('keydown', (event) => {
            const now = video.currentTime
            let target: number
            switch (event.key) {
                case ' ':
                case 'Enter':
                    event.preventDefault()
                    toggle()
                    return
                case 'ArrowRight':
                case 'ArrowUp':
                    target = now + ARROW_STEP_S
                    break
                case 'ArrowLeft':
                case 'ArrowDown':
                    target = now - ARROW_STEP_S
                    break
                case 'PageUp':
                    target = now + PAGE_STEP_S
                    break
                case 'PageDown':
                    target = now - PAGE_STEP_S
                    break
                case 'Home':
                    target = 0
                    break
                case 'End':
                    target = duration(clip)
                    break
                default:
                    return
            }
            event.preventDefault()
            seekTo(clip, target)
        })
        visibility.observe(root)
    }

    function reloadAllForTheme(): void {
        for (const clip of clips) if (clip.theme !== null) loadSources(clip)
    }

    new MutationObserver(reloadAllForTheme).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
    })
    prefersLight.addEventListener('change', reloadAllForTheme)
    reducedMotion.addEventListener('change', () => {
        for (const clip of clips) {
            clip.wantsPlay = !reducedMotion.matches
            apply(clip)
            syncState(clip)
        }
    })

    document.addEventListener('astro:page-load', () => {
        // Forget clips a client-side navigation removed.
        for (const clip of clips) {
            if (!clip.root.isConnected) {
                stopFrames(clip)
                visibility.unobserve(clip.root)
                clips.delete(clip)
            }
        }
        document.querySelectorAll<HTMLElement>('[data-product-clip]:not([data-bound])').forEach(bind)
    })
</script>
