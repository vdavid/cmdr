---
/**
  * The landing page's clip-led tour: trust first (nothing else does rollback), then reach, multi-rename,
  * the viewer, optional AI, and the craft. Every `/features#…` link targets a card id that
  * `src/pages/features.astro` renders.
  */
import ProductClip from './ProductClip.astro'
import ShowcaseClipRow from './ShowcaseClipRow.astro'
import ShowcaseSection from './ShowcaseSection.astro'
import Icon from './icons/Icon.astro'
import type { IconName } from './icons/icon-map'

const reach = [
  {
    href: '/features#android-devices',
    icon: 'smartphone',
    title: 'Phones and cameras',
    text: 'Android over MTP and ADB, up to 4x faster than Android File Transfer. Kindles and cameras, too.',
  },
  {
    href: '/features#network-drives',
    icon: 'server',
    title: 'Network drives',
    text: 'Cmdr has its own SMB client, 4–200x faster than what macOS uses, and NFS needs no system mount.',
  },
  {
    href: '/features#connect',
    icon: 'globe',
    title: 'Servers and cloud',
    text: 'SFTP, WebDAV, and S3-compatible buckets, with cost estimates for various S3-compatible providers.',
  },
  {
    href: '/features#git-browser',
    icon: 'git-branch',
    title: 'Git',
    text: 'Browse history, branches, and stashes as folders. Copy out files from your branch from last year.',
  },
  {
    href: '/features#restic-backups',
    icon: 'database',
    title: 'Backups',
    text: 'Open a restic backup and copy files out of your snapshot.',
  },
  {
    href: '/features#archives',
    icon: 'file-archive',
    title: 'Archives',
    text: 'Open zip, tar, and 7z files like folders. Copy/edit files in your existing zips.',
  },
] satisfies { href: string; icon: IconName; title: string; text: string }[]
---

<div class="showcase-tour">
    <!-- (a) Trust: the one thing no other file manager does goes first. -->
    <ShowcaseSection id="trust" eyebrow="File operations" title="File ops you can trust" layout="stacked">
        <p>
            Accurate progress display, ETAs, pause/resume/cancel.<br />Cmdr logs every operation,
            so you can roll them back, even days later.
        </p>
        <p class="text-base text-text-tertiary">
            See <a href="/data-safety">How Cmdr keeps your files safe</a> for details.
        </p>
        <div slot="media" class="space-y-16 md:space-y-20">
            <ShowcaseClipRow title="Pause, resume, roll back">
                <p>
                    Copy a big folder, pause it, and pick it up again. Changed your mind after it finished? Roll it
                    back from the operation log, and every file goes back.
                </p>
                <ProductClip
                    slot="clip"
                    slug="copy-rollback"
                    label="Copying a folder in Cmdr: the copy pauses, resumes, finishes, and then gets rolled back from the operation log."
                />
            </ShowcaseClipRow>
            <ShowcaseClipRow title="A queue for your file ops" flip>
                <p>
                    Start five copies, send them to the background, and keep working. Cmdr runs them one after the
                    other, and you can pause, resume, or reorder what's waiting.
                </p>
                <ProductClip
                    slot="clip"
                    slug="ops-queue"
                    label="Five folder copies queued in Cmdr's Operations window, running in the background one after the other until all are done."
                />
            </ShowcaseClipRow>
        </div>
    </ShowcaseSection>

    <!-- (b) Reach: second, because it's what people switching from Finder feel first. -->
    <ShowcaseSection id="reach" eyebrow="Connections" title="Handles all sorts of volumes" layout="stacked">
        <p>
            NAS (SMB), phones and cameras, SFTP/NFS servers, S3 buckets, WebDAV, restic backups, git repos, and archives
            work just like any folder on your Mac.
        </p>
        <p class="text-base text-text-tertiary">
            See <a href="/features#connect">the whole list</a> and their details.
        </p>
        <div slot="media" class="space-y-16 md:space-y-20">
            <ShowcaseClipRow title="Your NAS, NFS shares, and S3 buckets">
                <p>
                    Add an SMB server in a few seconds and browse it way faster than Finder does. NFS shares and S3
                    buckets open the same way, and Cmdr tells you what an S3 upload will cost before you copy.
                </p>
                <ProductClip
                    slot="clip"
                    slug="reach-network"
                    label="Adding an SMB server, an NFS share, and an S3 bucket in Cmdr, then browsing each one in a pane."
                />
            </ShowcaseClipRow>
            <ShowcaseClipRow title="Git repos, backups, and phones" flip>
                <p>
                    Browse a repo's commits as folders, unlock a restic backup and copy files out of any snapshot, or
                    open your Android phone over USB.
                </p>
                <ProductClip
                    slot="clip"
                    slug="reach-devices"
                    label="Browsing a git repo's history, a restic backup's snapshots, and an Android phone over MTP, each as folders in Cmdr."
                />
            </ShowcaseClipRow>
        </div>
        <ul slot="after" class="mx-auto mt-14 grid max-w-6xl gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            reach.map((item) => (
                    <li>
                        <a
                                href={item.href}
                                class="group flex h-full flex-col gap-2 rounded-xl border border-border bg-surface p-4 no-underline transition-colors duration-300 hover:border-accent/40 hover:bg-surface-elevated"
                        >
                            <span class="flex items-center gap-2">
                                <Icon name={item.icon} size={20} />
                                <span class="font-semibold text-text-primary">{item.title}</span>
                            </span>
                            <span class="text-sm/relaxed text-text-secondary">{item.text}</span>
                        </a>
                    </li>
            ))
          }
        </ul>
    </ShowcaseSection>

    <!-- (c) Multi-rename -->
    <ShowcaseSection id="multi-rename" eyebrow="Multi-rename" title="Bulk rename files">
        <p>Use a pattern, counters, search & replace, with a live preview. Changed your mind? You can undo it.</p>
        <p>
            If you like AI, you can also ask the (<em>optional!</em>) agent to “add an ISO date and lowercase all file names”.
        </p>
        <p class="text-base">
            <a href="/features#multi-rename">Multi-rename</a>
            <span class="text-text-tertiary" aria-hidden="true">&middot;</span>
            <a href="/features#ai-rename">Natural-language rename</a>
        </p>
        <ProductClip
                slot="media"
                slug="multi-rename"
                label="Cmdr's multi-rename window: a pattern with a counter renames a batch of photos, with the new names previewed live."
                caption="Multi-file rename demo (with AI disabled)"
        />
    </ShowcaseSection>

    <!-- (d) Viewer -->
    <ShowcaseSection id="opens-everything" eyebrow="Viewer" title="Opens all file types, fast" flip>
        <p>
            The built-in viewer opens text files, images, PDFs, and more, in media, text, binary, and hex views, and
            lets you search them, too.<br />It opens a 10 GB file in a second.
        </p>
        <p class="text-base"><a href="/features#file-viewer">The file viewer</a></p>
        <ProductClip
                slot="media"
                slug="viewer"
                label="Cmdr's viewer opening an image file and a Markdown file in different views."
                caption="See how Cmdr opens an image file, then a Markdown file"
        />
    </ShowcaseSection>

    <!-- (e) AI, opt-in -->
    <ShowcaseSection id="optional-ai" eyebrow="AI" title="Optional AI features">
        <p>
            Set up an LLM in Cmdr to search in plain language. Type “my tax report from last year”, and
            the agent turns it into filters.
        </p>
        <ul class="space-y-3 text-base">
            <li class="flex gap-3">
                <Icon name="toggle-left" size={22} class="mt-0.5 shrink-0" />
                <span
                ><strong class="font-semibold text-text-primary">Off by default.</strong> A lot of people just
                    want a nice two-pane file manager. With AI off (default), Cmdr is only that, no AI fluff.</span
                >
            </li>
            <li class="flex gap-3">
                <Icon name="sparkles" size={22} class="mt-0.5 shrink-0" />
                <span
                ><strong class="font-semibold text-text-primary">But it's quite cool!</strong> Smart disk cleanup, natural language search even in your photo content, ask stuff about your files. It's AI features that are <em>actually useful</em>.</span
                >
            </li>
            <li class="flex gap-3">
                <Icon name="laptop-minimal-check" size={22} class="mt-0.5 shrink-0" />
                <span><strong class="font-semibold text-text-primary">Can stay 100% on your Mac.</strong> A small
                    local model downloads and starts within Cmdr <em>if you want</em>. Or bring your own OpenAI, Claude, or
                    Gemini key: Claude Opus is certainly a few leagues smarter than the 3B-param model Cmdr runs locally.</span
                >
            </li>
        </ul>
        <p class="text-base">
            <a href="/features#search">Smart search</a>
            <span class="text-text-tertiary" aria-hidden="true">&middot;</span>
            <a href="/features#local-ai">The private model</a>
        </p>
        <ProductClip
                slot="media"
                slug="search"
                label="Searching in Cmdr by typing a plain-language request, which turns into filters and a list of matching files."
                caption="Searching in Cmdr with AI off, then on"
        />
    </ShowcaseSection>

    <!-- (f) Craft -->
    <ShowcaseSection id="follows-your-preferences" eyebrow="Details" title="Follows your preferences" flip>
        <p>Cmdr respects your Mac’s look (color, theme, etc.) and accessibility (motion, zoom, contrast, etc.) settings.</p>
        <p>It lets you use VoiceOver, works with keyboard only, mouse only, and has WCAG AA+ contrast levels everywhere.</p>
        <p>Translated to 14 languages. Switch between them without restarting.</p>
        <p class="text-base"><a href="/trust/accessibility-guide">Accessibility guide</a></p>
        <ProductClip
                slot="media"
                slug="language-switch"
                label="Switching Cmdr's language in Settings: the whole interface changes language on the spot."
                caption="Switching languages on the fly"
        />
    </ShowcaseSection>
</div>

<style>
    /* A hairline between sections, faded at the edges so the page reads as one tour. */
    .showcase-tour > :global(section + section)::before {
        content: '';
        position: absolute;
        top: 0;
        left: 10%;
        right: 10%;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--color-border), transparent);
    }
</style>
