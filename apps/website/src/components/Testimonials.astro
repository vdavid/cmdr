---
/**
 * Real users' words, verbatim. Every quote, its consent, and its chosen attribution live in David's
 * vault (`projects/Cmdr/Cmdr testimonials.md`): never edit a quote's wording, and trim only with an
 * ellipsis. An approved quote carries the name the person chose; a quote with no yes yet goes up
 * without a name (David's call, 2026-11-03), so `name` stays unset and the card shows only `detail`.
 * An avatar is a local copy of a picture the person offered (never hotlinked); without one, the card
 * shows their initials, or a person glyph when there's no name.
 *
 * The section shows three cards. Every quote is in the HTML, CSS hides all but the first three, and
 * the inline script shuffles the cards on each page load, so everyone gets their turn. Without JS,
 * the first three in the list show.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Icon from './icons/Icon.astro'
import svenKopetzkiAvatar from '../assets/testimonials/sven-kopetzki.jpg'
import andreDammeyerAvatar from '../assets/testimonials/andre-dammeyer.jpg'
import redditorAvatar from '../assets/testimonials/redditor.png'

interface Testimonial {
    /** Their own words, verbatim or as approved. Rendered as HTML so the smart-quotes pass curls it. */
    quote: string
    /** The name they chose to appear under. Unset for a quote without their yes. */
    name?: string
    /** Where the name links to: a profile they offered, or the public comment itself. */
    link?: string
    /** A second line under the name: where they're from, or what they do. */
    detail?: string
    avatar?: ImageMetadata
}

const testimonials: Testimonial[] = [
    {
        quote: "Believe me, I've tried every Total Commander alternative on macOS, and none of them clicked. Cmdr won me over because Cmd + arrow keys opens the current folder in the other pane. That's my entry test, and lots of apps already fail it. Not Cmdr! :-)",
        name: 'Sven Kopetzki',
        detail: 'Germany',
        avatar: svenKopetzkiAvatar,
    },
    {
        quote: 'I think Cmdr is really great. It runs all the day on my mac book. And I like how fast you are moving forward. Thank you!',
        name: 'André Dammeyer',
        link: 'https://www.linkedin.com/in/andredammeyer/',
        detail: 'Germany',
        avatar: andreDammeyerAvatar,
    },
    {
        quote: "I've been waiting for this file commander my whole life, even though I'm not young anymore. This program is already running circles around the competition currently available.",
        name: 'Robert Benedict',
    },
    {
        quote: "Thanks for CMDR!!! I installed and then uninstalled Double Commander along with a few other trial programs; I kept only CMDR and am very happy with it—it's fast, convenient, and has nothing superfluous. (translated from Russian)",
        name: 'Random redditor',
        link: 'https://www.reddit.com/r/MacOS/s/bLtp6WxbBW',
        detail: 'probably Russia',
        avatar: redditorAvatar,
    },
    {
        quote: "Oh what a wonderful program you are developing here! … I'm currently cleaning up my old macbook, moving stuff to a new one, use clumsy errorprone Finder in combo with rsync terminal. Cmdr is the lifesaver now!",
        detail: 'Austria',
    },
]

/** Up to two letters for the avatar: first and last name initials. */
function initials(name: string): string {
    const parts = name.trim().split(/\s+/)
    const first = parts[0]?.[0] ?? ''
    const last = parts.length > 1 ? (parts[parts.length - 1]?.[0] ?? '') : ''
    return (first + last).toUpperCase()
}
---

<section class="relative px-6 py-32" aria-labelledby="testimonials-heading">
    <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
            <h2 id="testimonials-heading" class="mb-4 text-3xl font-bold md:text-4xl lg:text-5xl">Testimonials</h2>
            <p class="text-lg text-text-secondary">These are real words from real people, no marketing crap.</p>
        </div>

        <div class="grid gap-6 md:grid-cols-3 [&>*:nth-child(n+4)]:hidden" data-testimonials>
            {
                testimonials.map((t) => (
                    <figure class="m-0 flex flex-col rounded-2xl border border-border bg-surface p-8 transition-all duration-300 hover:border-accent/30">
                        <span class="mb-2 text-4xl leading-none text-accent-text" aria-hidden="true">
                            &ldquo;
                        </span>
                        <blockquote class="mb-8 flex-1 text-lg/relaxed text-text-secondary italic" set:html={t.quote} />
                        <figcaption class="flex items-center gap-3">
                            <div class="rounded-full bg-linear-to-br from-accent to-accent/40 p-0.5" aria-hidden="true">
                                {t.avatar ? (
                                    <Image
                                        src={t.avatar}
                                        alt=""
                                        width={44}
                                        height={44}
                                        densities={[1, 2, 3]}
                                        format="webp"
                                        class="size-11 rounded-full object-cover"
                                    />
                                ) : (
                                    <span class="grid size-11 place-items-center rounded-full bg-surface-elevated text-sm font-semibold text-text-primary">
                                        {t.name ? initials(t.name) : <Icon name="user-round" size={20} />}
                                    </span>
                                )}
                            </div>
                            <div>
                                <p class="font-semibold text-text-primary">
                                    {t.link ? (
                                        <a
                                            href={t.link}
                                            target="_blank"
                                            rel="noopener"
                                            class="underline-offset-4 hover:text-accent-text hover:underline"
                                        >
                                            {t.name}
                                        </a>
                                    ) : (
                                        (t.name ?? 'An early user')
                                    )}
                                </p>
                                {t.detail && <p class="text-sm text-text-tertiary">{t.detail}</p>}
                            </div>
                        </figcaption>
                    </figure>
                ))
            }
        </div>
        <script is:inline>
            ;(function () {
                // Shuffle the cards (Fisher–Yates); CSS shows the first three.
                const grid = document.querySelector('[data-testimonials]')
                const cards = Array.from(grid.children)
                for (let i = cards.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1))
                    const swapped = cards[i]
                    cards[i] = cards[j]
                    cards[j] = swapped
                }
                grid.append(...cards)
            })()
        </script>
    </div>
</section>
