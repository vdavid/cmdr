# Paddle checkout configuration
# Get these from https://sandbox-vendors.paddle.com (sandbox) or https://vendors.paddle.com (live)

# Client-side token for Paddle.js (starts with "test_" for sandbox, "live_" for production)
PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx

# Price ID for the one paid tier: the $59 one-time Commercial license.
# Leave it empty and the buy button renders disabled, which is the safe failure: a wrong price ID
# charges a real customer the wrong amount with no error anywhere.
#   sandbox: pri_01m2qzb07a4vvnqqy5w0m6atcf
#   live:    pri_01m2qzb5frfcey74rz1vr4ryx9
# (Price IDs aren't secret; they ship in the built site's client-side JS.)
# The api-server's PRICE_ID_COMMERCIAL_PERPETUAL must hold the SAME id for the matching environment,
# or the webhook types the purchase as a subscription and mails the buyer a renewal promise.
PUBLIC_PADDLE_PRICE_ID_COMMERCIAL=pri_xxx

# Set to "live" for production, "sandbox" for testing.
# A production build (astro build / the Docker deploy) THROWS if this is "sandbox" while a token is
# present, so the live site can never silently ship test-mode checkout. The token must match the
# environment too: live_ for live, test_ for sandbox.
PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Escape hatch: set to "true" to build sandbox checkout in a production build on purpose (for
# example a local `pnpm check` website build or e2e run against the sandbox creds above). Never set
# this on the production server: it's what lets sandbox slip into a live deploy.
PUBLIC_PADDLE_ALLOW_SANDBOX=

# Download tracking redirect
# Routes downloads through the API server for server-side analytics.
# Production: https://api.getcmdr.com (downloads become /download/{version}/{arch})
# Leave empty to link directly to GitHub Releases (useful for dev).
PUBLIC_DOWNLOAD_BASE_URL=

# Umami analytics (self-hosted, cookieless, proxied through getcmdr.com/u/)
# Leave PUBLIC_UMAMI_WEBSITE_ID empty to disable tracking (for example, in dev env)
PUBLIC_UMAMI_HOST=/u
PUBLIC_UMAMI_WEBSITE_ID=

# Umami API credentials to be used in the dev env for scripts (not used by the website in prod!)
UMAMI_API_URL=https://your-umami-instance.example.com
UMAMI_USERNAME=admin
UMAMI_PASSWORD='your-password-here'

# PostHog (session replay, heatmaps, click tracking, proxied through getcmdr.com/ph/)
# Leave PUBLIC_POSTHOG_KEY empty to disable (for example, in dev env)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=/ph
