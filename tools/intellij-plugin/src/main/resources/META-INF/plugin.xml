<idea-plugin>
    <id>com.getcmdr.idea</id>
    <name>Cmdr dev tools</name>
    <vendor email="veszelovszki@gmail.com" url="https://getcmdr.com">David Veszelovszki</vendor>

    <description><![CDATA[
        Reading aids for the Cmdr repository. Scaffold so far: the only thing it does today is fold the literal
        <code>'CMDR_M0_PROBE'</code>. Commit-hash links in <code>CHANGELOG.md</code> and i18n keys folded to their
        English text come next. Never published to the Marketplace; sideloaded from
        <code>build/distributions/</code>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <!-- Svelte support is optional: without it `SvelteHTML` isn't a registered language, and a registration naming it
         in the main descriptor would log a resolution warning on every start. -->
    <depends optional="true" config-file="cmdr-svelte.xml">dev.blachut.svelte.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- M0 probe. Two registrations, and the count is the finding: a registration for `JavaScript` is shadowed at
             the `TypeScript` level and never reaches `.ts`, so every language needs naming.
             `LanguageCoverageSpikeTest` pins that. Delete once a real feature replaces it. -->
        <lang.foldingBuilder
            language="JavaScript"
            implementationClass="com.getcmdr.idea.m0.M0ProbeFoldingBuilder"/>
        <lang.foldingBuilder
            language="TypeScript"
            implementationClass="com.getcmdr.idea.m0.M0ProbeFoldingBuilder"/>
    </extensions>
</idea-plugin>
