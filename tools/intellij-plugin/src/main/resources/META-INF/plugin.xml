<idea-plugin>
    <id>com.getcmdr.idea</id>
    <name>Cmdr dev tools</name>
    <vendor email="veszelovszki@gmail.com" url="https://getcmdr.com">David Veszelovszki</vendor>

    <description><![CDATA[
        Reading aids for the Cmdr repository. It turns the trailing commit hashes on a <code>CHANGELOG.md</code> entry
        into links to their GitHub commits, and folds a message key to the English text it resolves to, so a screen's
        code reads like the screen. Every feature is off unless the open project carries
        <code>tools/intellij-plugin/cmdr-plugin.json</code>. Never published to the Marketplace; sideloaded from
        <code>build/distributions/</code>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <!-- Svelte support is optional: without it `SvelteHTML` isn't a registered language, and a registration naming it
         in the main descriptor would log a resolution warning on every start. -->
    <depends optional="true" config-file="cmdr-svelte.xml">dev.blachut.svelte.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Commit-hash links. The handler gives ⌘-click, the annotator gives the color. Both return immediately
             outside a Cmdr checkout and outside the files `cmdr-plugin.json` names. A `psi.referenceContributor`
             would be the obvious shape for the click and doesn't work on Markdown; see `DETAILS.md`. -->
        <gotoDeclarationHandler
            implementation="com.getcmdr.idea.features.changelog.ChangelogRefGotoDeclarationHandler"/>
        <annotator
            language="Markdown"
            implementationClass="com.getcmdr.idea.features.changelog.ChangelogRefAnnotator"/>

        <!-- i18n key preview. One registration per language, never one for a base language: folding registrations
             don't merge down the base-language chain, so `TypeScript` would silently see nothing through
             `JavaScript`. `SvelteHTML` is registered in `cmdr-svelte.xml`. Every language named here also belongs in
             `LanguageCoverageSpikeTest.FOLDING_LANGUAGES`. -->
        <lang.foldingBuilder
            language="JavaScript"
            implementationClass="com.getcmdr.idea.features.i18n.I18nKeyFoldingBuilder"/>
        <lang.foldingBuilder
            language="TypeScript"
            implementationClass="com.getcmdr.idea.features.i18n.I18nKeyFoldingBuilder"/>
    </extensions>
</idea-plugin>
